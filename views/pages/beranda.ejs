<!-- ==================== KOTAK 6 FOTO SPONSOR & MITRA RESMI ==================== -->
<%
  const filledSponsors = (sponsorList || []).filter(sp => sp && sp.fotoUrl && String(sp.fotoUrl).trim().length > 4);
