  <div class="container">
    <div class="sthac-sponsor-showcase">
      <div class="text-center mb-4">
        <span class="badge-green-soft d-inline-block mb-2"><i class="bi bi-stars me-1 text-warning"></i> OFFICIAL SPONSOR &amp; MITRA KEJUARAAN</span>
