      </div>

      <div class="row g-3 g-md-4 justify-content-center align-items-stretch">
        <% filledSponsors.forEach((sp) => { %>
          <div class="<%= spColClass %>">
            <a href="<%= sp.websiteUrl && sp.websiteUrl !== '#' ? sp.websiteUrl : 'javascript:void(0)' %>"
               <%= sp.websiteUrl && sp.websiteUrl !== '#' ? 'target="_blank" rel="noopener"' : '' %>
               class="sthac-sponsor-slot active-sponsor-card h-100 <%= countSp <= 2 ? 'single-featured' : '' %>"
               title="<%= sp.namaSponsor %> (<%= sp.kategori %>)">
              <div class="sponsor-img-box">
                <img src="<%= sp.fotoUrl %>" alt="<%= sp.namaSponsor %>" />
              </div>
              <div class="text-center w-100">
                <div class="sponsor-meta-title text-truncate"><%= sp.namaSponsor %></div>
                <span class="sponsor-meta-tier d-inline-block"><%= sp.kategori %></span>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>
<% } %>
<!-- ==================== END KOTAK 6 FOTO SPONSOR ==================== -->


<script>
  (function initCountdown() {
    const target = new Date('2026-11-14T07:00:00+07:00').getTime();
    function tick() {
      const diff = Math.max(0, target - Date.now());
      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const m = Math.floor((diff / 1000 / 60) % 60);
      const s = Math.floor((diff / 1000) % 60);
      const elD = document.getElementById('cd-days');
      if (elD) {
        elD.innerText = String(d).padStart(2, '0');
        document.getElementById('cd-hours').innerText = String(h).padStart(2, '0');
        document.getElementById('cd-mins').innerText = String(m).padStart(2, '0');
        document.getElementById('cd-secs').innerText = String(s).padStart(2, '0');
      }
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>
<script src="/socket.io/socket.io.js"></script>
<script>
  try {
    const socket = io();
    socket.on('score_updated', () => {
