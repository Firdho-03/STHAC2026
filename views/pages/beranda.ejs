<section class="py-5 border-top" id="sponsor-mitra" style="border-color: rgba(7,38,25,0.08) !important;">
  <div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <span class="badge rounded-pill px-3 py-1 mb-2 fw-bold" style="background: rgba(217,180,92,0.16); color: #9A721C; border: 1px solid rgba(217,180,92,0.45); font-size: 0.72rem;">
          <i class="bi bi-patch-check-fill me-1"></i> DUKUNGAN EKOSISTEM KEJUARAAN
        </span>
        <h2 class="font-display fw-bold text-uppercase mb-1">SPONSOR &amp; MITRA RESMI STHAC 2026</h2>
        <p class="text-muted sthac-section-subtext small mb-0">Terima kasih kepada seluruh sponsor, mitra strategis, dan pendukung resmi South Tangerang Horseback Archery Cup.</p>
      </div>
    </div>

    <div id="public-beranda-sponsor-grid">
      <% const activeSponsors = (typeof sponsorList !== 'undefined' && Array.isArray(sponsorList)) ? sponsorList.filter(s => s && s.fotoUrl && String(s.fotoUrl).trim().length > 2) : []; %>
      <% if (activeSponsors.length > 0) { %>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3 justify-content-center">
          <% activeSponsors.forEach((sp) => { %>
            <div class="col">
              <a href="<%= (sp.websiteUrl && sp.websiteUrl !== '#') ? sp.websiteUrl : 'javascript:void(0)' %>"
                 <%= (sp.websiteUrl && sp.websiteUrl !== '#') ? 'target="_blank" rel="noopener"' : '' %>
                 class="sthac-card p-3 h-100 d-flex flex-column justify-content-between text-decoration-none sthac-public-sponsor-box">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge rounded-pill px-2 py-1 text-truncate" style="max-width: 115px; font-size: 0.62rem; background: rgba(217,180,92,0.18); color: #8C6514; border: 1px solid rgba(217,180,92,0.45);">
                    <%= sp.kategori || 'Official Partner' %>
                  </span>
                  <i class="bi bi-patch-check-fill text-warning" style="font-size: 0.8rem;"></i>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center my-1 overflow-hidden" style="height: 96px; background: #FFFFFF; padding: 0.55rem; border: 1px solid rgba(7,38,25,0.08);">
                  <img src="<%= sp.fotoUrl %>" alt="<%= sp.namaSponsor %>" style="max-height: 82px; max-width: 100%; object-fit: contain;" />
                </div>
                <div class="text-center mt-2 pt-1">
                  <div class="fw-bold small text-truncate"><%= sp.namaSponsor %></div>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="sthac-card p-4 text-center text-muted small">
          Slot kemitraan dan sponsor resmi STHAC 2026 terbuka bagi instansi &amp; brand pendukung.
        </div>
      <% } %>
    </div>
  </div>
</section>
<!-- END SPONSOR & MITRA BERANDA SECTION -->
