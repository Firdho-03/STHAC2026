<div id="track-lightbox-modal" onclick="closeTrackLightbox()" style="display:none; position:fixed; inset:0; background:rgba(3,15,10,0.88); backdrop-filter:blur(6px); z-index:99999; align-items:center; justify-content:center; padding:1.5rem; cursor:zoom-out;">
  <div class="position-relative text-center" style="max-width:92vw; max-height:90vh;">
    <button type="button" onclick="closeTrackLightbox()" class="btn btn-gold-pill btn-sm px-3 py-1 mb-2">
      <i class="bi bi-x-lg me-1"></i> Tutup Gambar Penuh
    </button>
    <div>
      <img id="track-lightbox-img" src="/images/desain-lintasan-30m.svg" alt="Desain Lintasan Penuh" style="max-width:100%; max-height:82vh; background:#F4F1EA; padding:1rem; border-radius:0.9rem; border:2px solid #D9B45C; box-shadow:0 24px 60px rgba(0,0,0,0.65);" />
    </div>
  </div>
</div>

<script>
  window.openTrackLightbox = function(src) {
    const modal = document.getElementById('track-lightbox-modal');
    const img = document.getElementById('track-lightbox-img');
    if (img && src) img.src = src;
    if (modal) modal.style.display = 'flex';
  };
  window.closeTrackLightbox = function() {
    const modal = document.getElementById('track-lightbox-modal');
    if (modal) modal.style.display = 'none';
  };
</script>
