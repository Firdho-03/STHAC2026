<div class="container py-5">
  <div class="col-lg-8 mx-auto">
    <div class="text-center mb-4">
      <span class="badge-gold-outline mb-2">REGISTRASI ONLINE</span>
      <h1 class="font-display fw-bold text-uppercase text-white mb-1">Formulir Pendaftaran STHAC 2026</h1>
      <p class="text-white-50 mb-0">Data pendaftaran akan masuk ke antrean verifikasi panitia dan dikonfirmasi melalui WhatsApp.</p>
    </div>

    <ul class="nav nav-pills nav-fill gap-2 p-2 rounded-4 mb-4" style="background:rgba(255,255,255,0.04);border:1px solid rgba(217,180,92,0.25);" role="tablist">
      <li class="nav-item"><button class="btn btn-gold-pill w-100 active" id="t-btn-rider" onclick="switchRegTab('rider')" type="button">Daftar sebagai Rider</button></li>
      <li class="nav-item"><button class="btn btn-dark-pill w-100" id="t-btn-pelatih" onclick="switchRegTab('pelatih')" type="button">Daftar sebagai Pelatih</button></li>
      <li class="nav-item"><button class="btn btn-dark-pill w-100" id="t-btn-stable" onclick="switchRegTab('stable')" type="button">Daftar sebagai Stable</button></li>
    </ul>

    <!-- FORM RIDER (Persis daftar.php) -->
    <form id="reg-form-rider" onsubmit="submitPublicReg(event, '/api/register/rider')" class="sthac-card p-4 p-md-5">
      <input type="text" name="website_hp" style="display:none;" tabindex="-1" autocomplete="off" />
      <h4 class="font-display fw-bold text-uppercase text-white mb-4">Pendaftaran Rider</h4>
      <div class="row g-3 small">
        <div class="col-md-6"><label class="text-warning fw-bold mb-1">NAMA LENGKAP RIDER *</label><input name="namaLengkap" required class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">NAMA PANGGILAN</label><input name="namaPanggilan" class="form-control sthac-input" /></div>
        <div class="col-md-6">
          <label class="text-white-50 mb-1">KATEGORI</label>
          <select name="kategori" class="form-select sthac-input"><option value="U14">U14</option><option value="Terbuka">Terbuka</option></select>
        </div>
        <div class="col-md-6">
          <label class="text-white-50 mb-1">KELAS PERTANDINGAN</label>
          <select name="kelasDiikuti" class="form-select sthac-input">
            <option value="Belum menentukan">— Belum menentukan —</option>
            <option value="Beginner ( Walk )">Beginner (Walk) · U14</option>
            <option value="Beginner ( Trot )">Beginner (Trot) · Terbuka</option>
          </select>
        </div>
        <div class="col-md-6"><label class="text-white-50 mb-1">TANGGAL LAHIR</label><input type="date" name="tanggalLahir" class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-warning fw-bold mb-1">ASAL STABLE *</label><input name="asalStable" required class="form-control sthac-input" placeholder="Mis. Saiga Stable" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">KOTA / KABUPATEN</label><input name="kotaKabupaten" class="form-control sthac-input" value="Tangerang Selatan" /></div>
        <div class="col-md-6"><label class="text-warning fw-bold mb-1">NOMOR WHATSAPP *</label><input name="noWa" required class="form-control sthac-input" placeholder="0812xxxxxxxx" /></div>
        <div class="col-12"><label class="text-warning fw-bold mb-1">EMAIL *</label><input type="email" name="email" required class="form-control sthac-input" /></div>
        <div class="col-12"><label class="text-white-50 mb-1">PENGALAMAN BERKUDA MEMANAH</label><input name="pengalaman" class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">FOTO RIDER (UPLOAD)</label><input type="file" name="fotoFile" accept="image/*" class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">ATAU URL FOTO</label><input name="urlFoto" class="form-control sthac-input" placeholder="https://..." /></div>
        <div class="col-12"><label class="text-white-50 mb-1">CATATAN TAMBAHAN</label><textarea name="catatanTambahan" rows="2" class="form-control sthac-input"></textarea></div>
      </div>
      <div class="p-3 rounded-3 my-4 small text-white-50" style="background:rgba(217,180,92,0.08);border:1px solid rgba(217,180,92,0.25);">
        <i class="bi bi-info-circle text-warning me-1"></i> Dengan mengirim formulir ini, Anda menyetujui peraturan umum pertandingan serta bersedia mengikuti pemeriksaan kuda &amp; alat panah oleh panitia.
      </div>
      <button type="submit" class="btn btn-gold-pill w-100 py-3">Kirim Pendaftaran Rider</button>
    </form>

    <!-- FORM PELATIH -->
    <form id="reg-form-pelatih" onsubmit="submitPublicReg(event, '/api/register/pelatih')" class="sthac-card p-4 p-md-5" style="display:none;">
      <h4 class="font-display fw-bold text-uppercase text-white mb-4">Pendaftaran Pelatih / Trainer</h4>
      <div class="row g-3 small">
        <div class="col-md-6"><label class="text-warning fw-bold mb-1">NAMA LENGKAP *</label><input name="namaLengkap" required class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">NAMA PANGGILAN</label><input name="namaPanggilan" class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">SPESIALISASI</label><input name="spesialis" value="Berkuda Memanah" class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">ASAL STABLE</label><input name="stableAsal" class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">SERTIFIKASI</label><input name="sertifikasi" class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-warning fw-bold mb-1">NOMOR WHATSAPP *</label><input name="noWa" required class="form-control sthac-input" /></div>
        <div class="col-12"><label class="text-warning fw-bold mb-1">EMAIL *</label><input type="email" name="email" required class="form-control sthac-input" /></div>
        <div class="col-12"><label class="text-white-50 mb-1">BIO / PENGALAMAN MELATIH</label><textarea name="pengalamanMelatih" rows="2" class="form-control sthac-input"></textarea></div>
      </div>
      <button type="submit" class="btn btn-gold-pill w-100 py-3 mt-4">Kirim Pendaftaran Pelatih</button>
    </form>

    <!-- FORM STABLE -->
    <form id="reg-form-stable" onsubmit="submitPublicReg(event, '/api/register/stable')" class="sthac-card p-4 p-md-5" style="display:none;">
      <h4 class="font-display fw-bold text-uppercase text-white mb-4">Pendaftaran Stable / Klub</h4>
      <div class="row g-3 small">
        <div class="col-md-6"><label class="text-warning fw-bold mb-1">NAMA STABLE *</label><input name="namaStable" required class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">KOTA / KABUPATEN</label><input name="kotaKabupaten" class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">PROVINSI</label><input name="provinsi" value="Banten" class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">PELATIH UTAMA</label><input name="pelatihUtama" class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-warning fw-bold mb-1">KONTAK / WHATSAPP *</label><input name="noWa" required class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-warning fw-bold mb-1">EMAIL *</label><input type="email" name="email" required class="form-control sthac-input" /></div>
        <div class="col-12"><label class="text-white-50 mb-1">ALAMAT &amp; DESKRIPSI STABLE</label><textarea name="deskripsi" rows="2" class="form-control sthac-input"></textarea></div>
      </div>
      <button type="submit" class="btn btn-gold-pill w-100 py-3 mt-4">Kirim Pendaftaran Stable</button>
    </form>
  </div>
</div>

<script>
  function switchRegTab(tab) {
    ['rider', 'pelatih', 'stable'].forEach(t => {
      document.getElementById('reg-form-' + t).style.display = (t === tab) ? 'block' : 'none';
      document.getElementById('t-btn-' + t).className = (t === tab) ? 'btn btn-gold-pill w-100' : 'btn btn-dark-pill w-100';
    });
  }

  async function submitPublicReg(e, url) {
    e.preventDefault();
    const res = await fetch(url, { method: 'POST', body: new FormData(e.target) });
    const out = await res.json();
    if (out.success) {
      alert('Terima kasih! Pendaftaran Anda telah masuk ke antrean verifikasi Panitia STHAC.');
      window.location.href = '/profile';
    } else alert('Gagal: ' + out.error);
  }
</script>