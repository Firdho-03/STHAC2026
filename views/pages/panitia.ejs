                  <td class="text-end text-nowrap">
                    <button type="button" class="btn btn-sm btn-dark-pill px-2 py-1 me-1"
                      onclick='fillKelasEdit(<%- JSON.stringify({ id: k.id, namaKelas: k.namaKelas, kategori: k.kategori, lintasanId: k.lintasanId || 1, jumlahRun: k.jumlahRun }) %>)'>
                      <i class="bi bi-pencil"></i> Edit
                    </button>
                    <button type="button" class="btn btn-sm btn-logout-pill px-2 py-1" onclick="deleteEntity('kelas', <%= k.id %>, '<%= k.namaKelas %>')">
                      <i class="bi bi-trash"></i>
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

