                <div class="col-md-3">
                  <label class="small fw-bold text-warning mb-1">KUOTA</label>
                  <input type="number" name="kuotaPeserta" id="inp-kelas-kuota" value="30" min="1" max="100" class="form-control sthac-input text-center" />
