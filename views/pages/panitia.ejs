<script>
  let pendingOtpEmail = '';
  let pendingOtpName = '';
  let pendingOtpRole = '';
  let pendingOtpPurpose = 'LOGIN';
  let popupConfirmCallback = null;

  // ==================== POP-UP MODAL MODERN ====================
  window.showSthacPopup = function(title, message, type = 'error', onConfirm = null) {
    const backdrop = document.getElementById('sthac-popup-backdrop');
    const iconWrap = document.getElementById('popup-icon-wrap');
    const iconEl = document.getElementById('popup-icon');
    const titleEl = document.getElementById('popup-title');
    const msgEl = document.getElementById('popup-message');
    const btnCancel = document.getElementById('popup-btn-cancel');
    const btnOk = document.getElementById('popup-btn-ok');

    titleEl.innerText = title;
    msgEl.innerHTML = message;
    popupConfirmCallback = onConfirm;

    if (type === 'success') {
      iconWrap.style.background = 'rgba(16, 185, 129, 0.16)';
      iconWrap.style.color = '#10B981';
      iconEl.className = 'bi bi-check-circle-fill';
      btnCancel.classList.add('d-none');
      btnOk.innerText = 'Selesai';
    } else if (type === 'confirm') {
      iconWrap.style.background = 'rgba(245, 158, 11, 0.16)';
      iconWrap.style.color = '#F59E0B';
      iconEl.className = 'bi bi-question-circle-fill';
      btnCancel.classList.remove('d-none');
      btnOk.innerText = 'Ya, Lanjutkan';
    } else {
      iconWrap.style.background = 'rgba(220, 38, 38, 0.16)';
      iconWrap.style.color = '#EF4444';
      iconEl.className = 'bi bi-exclamation-triangle-fill';
      btnCancel.classList.add('d-none');
      btnOk.innerText = 'Coba Lagi';
    }
    backdrop.style.display = 'flex';
  };

  window.closeSthacPopup = function(confirmed = false) {
    document.getElementById('sthac-popup-backdrop').style.display = 'none';
    if (confirmed && typeof popupConfirmCallback === 'function') {
      const cb = popupConfirmCallback;
      popupConfirmCallback = null;
      cb();
    } else {
      popupConfirmCallback = null;
    }
  };

  // ==================== AUTENTIKASI LOGIN & VERIFIKASI OTP ====================
  window.switchAuthMode = function(mode) {
    ['login-otp', 'register-otp', 'quick-pass'].forEach(m => {
      const pane = document.getElementById('auth-pane-' + m);
      const btn = document.getElementById('tab-btn-' + m);
      if (pane) pane.style.display = (m === mode) ? 'block' : 'none';
      if (btn) btn.className = 'btn btn-sm flex-fill py-2 ' + (m === mode ? 'btn-gold-pill' : 'btn-dark-pill');
    });
    document.getElementById('auth-otp-verify-box').style.display = 'none';
  };

  window.resetOtpView = function() {
    switchAuthMode(pendingOtpPurpose === 'REGISTER' ? 'register-otp' : 'login-otp');
  };

  window.resendCurrentOtp = function() {
    if (!pendingOtpEmail) return;
    requestOtpFromServer(pendingOtpEmail, pendingOtpName, pendingOtpRole, pendingOtpPurpose);
  };

  window.handleRequestOtp = function(e, purpose) {
    e.preventDefault();
    const email = purpose === 'REGISTER'
      ? document.getElementById('inp-reg-email').value.trim()
      : document.getElementById('inp-login-email').value.trim();
    const namaLengkap = purpose === 'REGISTER'
      ? document.getElementById('inp-reg-name').value.trim()
      : email.split('@')[0];
    const jabatan = purpose === 'REGISTER'
      ? document.getElementById('inp-reg-role').value
      : 'Dewan Juri & Panitia';

    if (!email) return showSthacPopup('Email Belum Diisi', 'Masukkan alamat email resmi Anda.', 'error');

    pendingOtpEmail = email;
    pendingOtpName = namaLengkap;
    pendingOtpRole = jabatan;
    pendingOtpPurpose = purpose;
    requestOtpFromServer(email, namaLengkap, jabatan, purpose);
  };

  async function requestOtpFromServer(email, namaLengkap, jabatan, purpose) {
    try {
      const res = await fetch('/api/panitia/request-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, namaLengkap, jabatan, purpose })
      });
      const out = await res.json();
      if (out.ok || out.success) {
        document.getElementById('auth-pane-login-otp').style.display = 'none';
        document.getElementById('auth-pane-register-otp').style.display = 'none';
        document.getElementById('auth-otp-verify-box').style.display = 'block';
        document.getElementById('lbl-target-otp-email').innerText = email;
        const codeInp = document.getElementById('inp-verify-otp-code');
        codeInp.value = '';
        codeInp.focus();
      } else {
        showSthacPopup('Gagal Mengirim OTP', out.message || 'Tidak dapat mengirim kode OTP.', 'error');
      }
    } catch (err) {
      showSthacPopup('Gangguan Koneksi', 'Tidak dapat terhubung ke server: ' + err.message, 'error');
    }
  }

  window.handleVerifyOtp = async function(e) {
    e.preventDefault();
    const codeInp = document.getElementById('inp-verify-otp-code');
    const otpCode = codeInp.value.trim();

    if (!otpCode || otpCode.length < 6) {
      return showSthacPopup('Kode OTP Belum Lengkap', 'Masukkan 6 digit angka kode OTP yang dikirim ke email Anda.', 'error');
    }

    try {
      const res = await fetch('/api/panitia/verify-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: pendingOtpEmail, otpCode })
      });
      const out = await res.json();
      if (res.ok && (out.ok || out.success)) {
        activateAdminSession(out.user || { namaLengkap: pendingOtpName, jabatan: pendingOtpRole, email: pendingOtpEmail });
      } else {
        codeInp.value = '';
        codeInp.focus();
        showSthacPopup('Kode OTP Salah!', out.message || 'Kode OTP yang Anda masukkan tidak sesuai atau sudah kedaluwarsa.', 'error');
      }
    } catch (err) {
      showSthacPopup('Gagal Memverifikasi OTP', 'Terjadi kesalahan saat memverifikasi kode OTP.', 'error');
    }
  };

  window.handleQuickLogin = async function(e) {
    e.preventDefault();
    const passInp = document.getElementById('inp-quick-password');
    const password = passInp.value.trim();
    try {
      const res = await fetch('/api/panitia/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password })
      });
      const out = await res.json();
      if (res.ok && (out.ok || out.success)) {
        activateAdminSession(out.user || { namaLengkap: 'Panitia Utama', jabatan: 'Dewan Juri', email: 'admin@sthac.com' });
      } else {
        passInp.value = '';
        passInp.focus();
        showSthacPopup('Sandi Otorisasi Salah', 'Kode sandi akses yang Anda masukkan tidak valid.', 'error');
      }
    } catch (err) {
      showSthacPopup('Gangguan Koneksi', 'Gagal memverifikasi sandi akses.', 'error');
    }
  };

  function activateAdminSession(user) {
    sessionStorage.setItem('sthac_admin_auth', '1');
    sessionStorage.setItem('sthac_admin_user', JSON.stringify(user));
    localStorage.setItem('sthac_admin_auth', '1');
    localStorage.setItem('sthac_admin_user', JSON.stringify(user));
    renderAdminSessionState();
  }

  window.logoutAdmin = function() {
    sessionStorage.removeItem('sthac_admin_auth');
