<div class="container py-4">

  <!-- ==================== POP-UP MODAL DIALOG (ERROR OTP / KONFIRMASI / SUKSES) ==================== -->
  <div id="sthac-popup-backdrop" style="display:none; position:fixed; inset:0; background:rgba(3,19,12,0.78); backdrop-filter:blur(6px); z-index:99999; align-items:center; justify-content:center; padding:1rem;">
    <div class="sthac-card p-4 p-md-5 text-center mx-auto" style="max-width:430px; width:100%; border:2px solid var(--border-dropdown); animation:dropdownPopIn 0.22s ease forwards;">
      <div id="popup-icon-wrap" class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width:64px; height:64px; background:rgba(220,38,38,0.15); color:#EF4444; font-size:2rem;">
        <i id="popup-icon" class="bi bi-exclamation-triangle-fill"></i>
      </div>
      <h4 id="popup-title" class="font-display fw-bold text-uppercase text-white mb-2">Kode OTP Tidak Valid</h4>
      <p id="popup-message" class="small text-white-50 mb-4" style="line-height:1.6;">Kode OTP yang Anda masukkan salah atau telah kedaluwarsa.</p>
      <div class="d-flex justify-content-center gap-2">
        <button type="button" id="popup-btn-cancel" onclick="closeSthacPopup(false)" class="btn btn-dark-pill px-4 py-2 d-none">Batal</button>
        <button type="button" id="popup-btn-ok" onclick="closeSthacPopup(true)" class="btn btn-gold-pill px-5 py-2 fw-bold">Mengerti</button>
      </div>
    </div>
  </div>

  <!-- ==================== GATE LOGIN PANEL PANITIA (CLEAN & PRODUCTION READY) ==================== -->
  <div id="admin-login-gate" class="py-5">
    <div class="sthac-card p-4 p-md-5 mx-auto" style="max-width: 500px;">
      <div class="text-center mb-4">
        <img src="<%= setting.logoUrl %>" alt="STHAC Logo" style="width:64px;height:64px;object-fit:contain;" class="mb-2" />
        <h2 class="font-display fw-bold text-uppercase text-white mb-1">PANEL PANITIA · STHAC 2026</h2>
        <p class="small text-white-50 mb-0">Autentikasi resmi kepanitiaan &amp; dewan juri menggunakan Kode OTP Email.</p>
      </div>

      <div class="p-1 rounded-pill mb-4 d-flex justify-content-between gap-1" style="background: rgba(15, 41, 30, 0.14); border: 1px solid var(--border-main);">
        <button type="button" id="tab-btn-login-otp" onclick="switchAuthMode('login-otp')" class="btn btn-sm btn-gold-pill flex-fill py-2">
          <i class="bi bi-envelope-check me-1"></i> Login OTP
        </button>
        <button type="button" id="tab-btn-register-otp" onclick="switchAuthMode('register-otp')" class="btn btn-sm btn-dark-pill flex-fill py-2">
          <i class="bi bi-person-plus me-1"></i> Daftar Panitia
        </button>
        <button type="button" id="tab-btn-quick-pass" onclick="switchAuthMode('quick-pass')" class="btn btn-sm btn-dark-pill flex-fill py-2">
          <i class="bi bi-shield-lock me-1"></i> Sandi Akses
        </button>
      </div>

      <!-- FORM MASUK EMAIL OTP -->
      <div id="auth-pane-login-otp">
        <form onsubmit="handleRequestOtp(event, 'LOGIN')">
          <div class="mb-3">
            <label class="small fw-bold text-warning mb-1 d-block">ALAMAT EMAIL PANITIA / JURI *</label>
            <input type="email" id="inp-login-email" class="form-control sthac-input" placeholder="Masukkan email resmi Anda..." required />
          </div>
          <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold">
            <i class="bi bi-send-fill me-1"></i> Kirim Kode OTP ke Email
          </button>
        </form>
      </div>

      <!-- FORM DAFTAR PANITIA BARU -->
      <div id="auth-pane-register-otp" style="display:none;">
        <form onsubmit="handleRequestOtp(event, 'REGISTER')">
          <div class="mb-3">
            <label class="small fw-bold text-warning mb-1 d-block">NAMA LENGKAP *</label>
            <input type="text" id="inp-reg-name" class="form-control sthac-input" placeholder="Nama lengkap beserta gelar" required />
          </div>
          <div class="row g-2 mb-3">
            <div class="col-md-7">
              <label class="small fw-bold text-warning mb-1 d-block">ALAMAT EMAIL *</label>
              <input type="email" id="inp-reg-email" class="form-control sthac-input" placeholder="nama@email.com" required />
            </div>
            <div class="col-md-5">
              <label class="small fw-bold text-warning mb-1 d-block">JABATAN *</label>
              <select id="inp-reg-role" class="form-select sthac-input">
                <option value="Juri Utama">Juri Utama</option>
                <option value="Scorer / Pencatat">Scorer / Pencatat</option>
                <option value="Course Designer">Course Designer</option>
                <option value="Panitia Teknis">Panitia Teknis</option>
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold">
            <i class="bi bi-envelope-check-fill me-1"></i> Kirim Kode Verifikasi OTP
          </button>
        </form>
      </div>

      <!-- LAYAR BERSIH VERIFIKASI 6 DIGIT OTP -->
      <div id="auth-otp-verify-box" style="display:none;">
        <div class="p-3 rounded-3 mb-3 text-center" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.35);">
          <i class="bi bi-envelope-paper-heart-fill text-success fs-4 d-block mb-1"></i>
          <div class="small text-white">Kode OTP 6 digit telah dikirimkan ke:</div>
          <div id="lbl-target-otp-email" class="fw-bold text-warning small"></div>
        </div>

        <form onsubmit="handleVerifyOtp(event)">
          <div class="mb-3">
            <label class="small fw-bold text-warning mb-2 d-block text-center">MASUKKAN 6 DIGIT KODE OTP</label>
            <input type="text" id="inp-verify-otp-code" maxlength="6" inputmode="numeric" autocomplete="one-time-code"
              class="form-control sthac-input text-center font-monospace fs-4 fw-bold"
              style="letter-spacing: 8px;" placeholder="••••••" required />
          </div>
          <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold">
            <i class="bi bi-shield-check me-1"></i> Verifikasi &amp; Masuk Panel
          </button>
          <div class="d-flex justify-content-between align-items-center pt-2">
            <a href="#" onclick="resetOtpView(); return false;" class="small text-white-50 text-decoration-none">
              <i class="bi bi-arrow-left me-1"></i> Ganti Email
            </a>
            <a href="#" onclick="resendCurrentOtp(); return false;" class="small text-warning text-decoration-none fw-semibold">
              <i class="bi bi-arrow-clockwise me-1"></i> Kirim Ulang OTP
            </a>
          </div>
        </form>
      </div>

      <!-- SANDI AKSES PANITIA -->
      <div id="auth-pane-quick-pass" style="display:none;">
        <form onsubmit="handleQuickLogin(event)">
          <div class="mb-3">
            <label class="small fw-bold text-warning mb-1 d-block">KODE AKSES OTORISASI PANITIA *</label>
            <input type="password" id="inp-quick-password" class="form-control sthac-input" placeholder="Masukkan sandi otorisasi panitia..." required />
          </div>
          <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold">
            <i class="bi bi-box-arrow-in-right me-1"></i> Masuk Panel Panitia
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- ==================== DASHBOARD INTERAKTIF PANEL PANITIA (PROJECT SAIGA) ==================== -->
  <div id="admin-dashboard-panel" style="display:none;">

    <!-- BARIS 1: TOP ADMIN NAVBAR (1 BARIS SIMETRIS & RAPI) -->
    <div class="admin-navbar-card mb-4">
      <div class="admin-navbar-inner">
        
        <!-- Kiri: Identitas Panel Panitia -->
        <div class="admin-nav-brand">
          <img src="<%= setting.logoUrl %>" alt="Logo" style="width:34px;height:34px;object-fit:contain;" onerror="this.style.display='none'" />
          <span class="badge rounded-pill px-3 py-2 fw-bold" style="background:#072619; color:#F2E0AC; font-size:0.74rem; letter-spacing:0.6px;">
            <i class="bi bi-shield-check me-1"></i> PANEL PANITIA · STHAC
          </span>
          <span class="d-none" id="lbl-active-admin-user"></span>
        </div>

        <!-- Tengah: 4 Menu Utama Sejajar 1 Baris -->
        <div class="admin-nav-center" id="admin-nav-pills">
          <button type="button" id="adm-group-ringkasan" onclick="openAdminTab('ringkasan')" class="btn btn-sm btn-gold-pill">
            <i class="bi bi-speedometer2 me-1"></i> Ringkasan
          </button>

          <div class="dropdown">
            <button type="button" id="adm-group-peserta" class="btn btn-sm btn-dark-pill dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-people-fill me-1"></i> Peserta &amp; Klub
            </button>
            <ul class="dropdown-menu dropdown-menu-sthac">
              <li><a class="dropdown-item adm-sub-link" data-tab="pendaftar" href="javascript:void(0)" onclick="openAdminTab('pendaftar')"><i class="bi bi-person-check-fill me-2 text-warning"></i> Pendaftar (<%= stats.menungguAcc %> Pending)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="rider" href="javascript:void(0)" onclick="openAdminTab('rider')"><i class="bi bi-person-badge-fill me-2 text-warning"></i> Data Rider (<%= stats.riderAktif %>)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="pelatih" href="javascript:void(0)" onclick="openAdminTab('pelatih')"><i class="bi bi-person-workspace me-2 text-warning"></i> Data Pelatih (<%= stats.pelatih %>)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="stable" href="javascript:void(0)" onclick="openAdminTab('stable')"><i class="bi bi-shield-shaded me-2 text-warning"></i> Data Stable (<%= stats.stable %>)</a></li>
            </ul>
          </div>

          <div class="dropdown">
            <button type="button" id="adm-group-teknis" class="btn btn-sm btn-dark-pill dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-trophy-fill me-1"></i> Teknis &amp; Penilaian
            </button>
            <ul class="dropdown-menu dropdown-menu-sthac">
              <li><a class="dropdown-item adm-sub-link" data-tab="acara" href="javascript:void(0)" onclick="openAdminTab('acara')"><i class="bi bi-calendar-range-fill me-2 text-warning"></i> Seri &amp; Kelas (<%= stats.totalKelas %>)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="lintasan" href="javascript:void(0)" onclick="openAdminTab('lintasan')"><i class="bi bi-signpost-split-fill me-2 text-warning"></i> Master Lintasan (<%= stats.totalLintasan %>)</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="penilaian" href="javascript:void(0)" onclick="openAdminTab('penilaian')"><i class="bi bi-stopwatch-fill me-2 text-danger"></i> Input Penilaian Run</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="poin" href="javascript:void(0)" onclick="openAdminTab('poin')"><i class="bi bi-award-fill me-2 text-warning"></i> Poin &amp; Juara Umum</a></li>
            </ul>
          </div>

          <div class="dropdown">
            <button type="button" id="adm-group-sistem" class="btn btn-sm btn-dark-pill dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-sliders me-1"></i> Sistem &amp; Konten
            </button>
            <ul class="dropdown-menu dropdown-menu-sthac">
              <li><a class="dropdown-item adm-sub-link" data-tab="panitia" href="javascript:void(0)" onclick="openAdminTab('panitia')"><i class="bi bi-person-vcard-fill me-2 text-warning"></i> Panitia &amp; Juri (<%= stats.panitia %>)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="unduhan" href="javascript:void(0)" onclick="openAdminTab('unduhan')"><i class="bi bi-file-earmark-arrow-down-fill me-2 text-warning"></i> Unduhan Dokumen (<%= stats.dokumen %>)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="berita" href="javascript:void(0)" onclick="openAdminTab('berita')"><i class="bi bi-newspaper me-2 text-warning"></i> Berita &amp; Warta (<%= stats.berita %>)</a></li>
              <li><a id="dropdown-item-rundown-aturan" class="dropdown-item adm-sub-link" data-tab="rundown" href="javascript:void(0)" onclick="openAdminTab('rundown')"><i class="bi bi-clock-history me-2 text-warning"></i> Rundown &amp; Aturan (<span id="badge-nav-rundown">9</span>)</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="sponsor" href="javascript:void(0)" onclick="openAdminTab('sponsor')"><i class="bi bi-patch-check-fill me-2 text-warning"></i> Sponsor &amp; Mitra (6 Slot)</a></li>
            </ul>
          </div>
        </div>

        <!-- Kanan: Setelan & Keluar -->
        <div class="admin-nav-right">
          <button type="button" id="adm-group-setelan" onclick="openAdminTab('setelan')" class="btn btn-sm btn-dark-pill">
            <i class="bi bi-gear-fill text-warning me-1"></i> Setelan
          </button>
          <button type="button" onclick="logoutAdmin()" class="btn btn-sm btn-logout-pill">
            <i class="bi bi-box-arrow-right me-1"></i> Keluar
          </button>
        </div>

      </div>
    </div>

    <!-- ==================== 1. TAB RINGKASAN (PUSAT KENDALI KEJUARAAN) ==================== -->
    <div id="adm-sec-ringkasan" class="admin-section">
      <div class="p-3 rounded-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span><i class="bi bi-circle-fill text-success me-2" style="font-size:0.55rem;"></i> Selamat datang, <strong id="lbl-welcome-admin">Panitia STHAC (Super Admin)</strong>.</span>
        <span class="small"><i class="bi bi-calendar3 me-1"></i> Seri 1: Sabtu, 14 November 2026 · Pendaftaran: <strong><%= setting.registrationOpen ? 'Dibuka' : 'Ditutup' %></strong></span>
      </div>

      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; RINGKASAN EKSEKUTIF</div>
          <h2 class="font-display fw-bold text-white mb-1">Pusat Kendali Kejuaraan</h2>
          <p class="small text-white-50 mb-0">Kelola pendaftaran, peserta, kelas, dan hasil penilaian kejuaraan South Tangerang Horseback Archery Cup.</p>
        </div>
        <span class="badge-green-soft px-3 py-2"><i class="bi bi-check2-circle me-1"></i> Sistem Live Terkoneksi</span>
      </div>

      <!-- 8 KARTU STATISTIK GAYA SAIGA (GRID 4x2 DENGAN IKON & BADGE) -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('pendaftar')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">PENDAFTAR MENUNGGU ACC</span>
              <span class="badge-amber-soft">MENUNGGU</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <div class="stat-num"><%= stats.menungguAcc %></div>
                <small class="text-white-50" style="font-size:0.72rem;">Perlu verifikasi panitia</small>
              </div>
              <span class="stat-icon"><i class="bi bi-person-exclamation"></i></span>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('pendaftar')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">PENDAFTAR DITERIMA</span>
              <span class="badge-green-soft">TERVERIFIKASI</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <div class="stat-num"><%= stats.pendaftarDiterima %></div>
                <small class="text-white-50" style="font-size:0.72rem;">Terdaftar resmi di seri</small>
              </div>
              <span class="stat-icon"><i class="bi bi-person-check-fill"></i></span>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('rider')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">RIDER AKTIF</span>
              <span class="badge-green-soft">AKTIF</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <div class="stat-num"><%= stats.riderAktif %></div>
                <small class="text-white-50" style="font-size:0.72rem;">Atlet siap bertanding</small>
              </div>
              <span class="stat-icon"><i class="bi bi-person-badge-fill"></i></span>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('pelatih')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">PELATIH RESMI</span>
              <span class="badge-gold-outline">TERDAFTAR</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <div class="stat-num"><%= stats.pelatihAktif %></div>
                <small class="text-white-50" style="font-size:0.72rem;">Lisensi Pordasi / IHAA</small>
              </div>
              <span class="stat-icon"><i class="bi bi-person-workspace"></i></span>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('stable')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">STABLE &amp; KLUB</span>
              <span class="badge-gold-outline">PARTISIPAN</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <div class="stat-num"><%= stats.stableAktif %></div>
                <small class="text-white-50" style="font-size:0.72rem;">Kontingen klub berkuda</small>
              </div>
              <span class="stat-icon"><i class="bi bi-shield-shaded"></i></span>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('penilaian')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">HASIL RUN TERSIMPAN</span>
              <span class="badge-green-soft">LIVE SCORE</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <div class="stat-num"><%= stats.totalRunTercatat %></div>
                <small class="text-white-50" style="font-size:0.72rem;">Terekam di papan skor</small>
              </div>
              <span class="stat-icon"><i class="bi bi-stopwatch-fill"></i></span>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('panitia')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">PANITIA &amp; JURI</span>
              <span class="badge-gold-outline">PETUGAS</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <div class="stat-num"><%= stats.totalPanitia %></div>
                <small class="text-white-50" style="font-size:0.72rem;">Dewan juri &amp; scorer</small>
              </div>
              <span class="stat-icon"><i class="bi bi-person-vcard-fill"></i></span>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('unduhan')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">DOKUMEN UNDUHAN</span>
              <span class="badge-green-soft">PUBLIK</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <div class="stat-num"><%= stats.totalDokumen %></div>
                <small class="text-white-50" style="font-size:0.72rem;">THB &amp; berkas regulasi</small>
              </div>
              <span class="stat-icon"><i class="bi bi-file-earmark-arrow-down-fill"></i></span>
            </div>
          </div>
        </div>
      </div>

      <!-- LANGKAH PENGELOLAAN (DENGAN BADGE LINGKARAN 1-6) & PINTASAN -->
      <div class="row g-4 mb-4">
        <div class="col-lg-7">
          <div class="sthac-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="font-display fw-bold text-uppercase text-white mb-0"><i class="bi bi-compass text-warning me-2"></i>Langkah Pengelolaan</h5>
              <span class="badge-green-soft">Alur Kerja Standar</span>
            </div>
            <div class="vstack gap-3 small">
              <div class="d-flex align-items-start gap-3">
                <span class="saiga-step-circle">1</span>
                <div><strong class="text-white">Verifikasi pendaftar</strong> — setujui rider/pelatih/stable dari halaman <a href="javascript:void(0)" onclick="openAdminTab('pendaftar')" class="text-warning">Pendaftar</a>.</div>
              </div>
              <div class="d-flex align-items-start gap-3">
                <span class="saiga-step-circle">2</span>
                <div><strong class="text-white">Atur seri &amp; kelas</strong> — tanggal, lintasan, jumlah run dinilai di halaman <a href="javascript:void(0)" onclick="openAdminTab('acara')" class="text-warning">Seri &amp; Kelas</a>.</div>
              </div>
              <div class="d-flex align-items-start gap-3">
                <span class="saiga-step-circle">3</span>
                <div><strong class="text-white">Daftarkan peserta ke kelas</strong> — kelola direktori dari halaman <a href="javascript:void(0)" onclick="openAdminTab('penilaian')" class="text-warning">Penilaian</a> atau <a href="javascript:void(0)" onclick="openAdminTab('rider')" class="text-warning">Rider</a>.</div>
              </div>
              <div class="d-flex align-items-start gap-3">
                <span class="saiga-step-circle">4</span>
                <div><strong class="text-white">Masukkan hasil tiap run</strong> — skor dihitung otomatis di <a href="javascript:void(0)" onclick="openAdminTab('penilaian')" class="text-warning">Input Penilaian Run</a>; papan skor publik langsung diperbarui.</div>
              </div>
              <div class="d-flex align-items-start gap-3">
                <span class="saiga-step-circle">5</span>
                <div><strong class="text-white">Periksa klasemen poin</strong> — poin juara umum dihitung otomatis di <a href="javascript:void(0)" onclick="openAdminTab('poin')" class="text-warning">Poin &amp; Juara</a>.</div>
              </div>
              <div class="d-flex align-items-start gap-3">
                <span class="saiga-step-circle">6</span>
                <div><strong class="text-white">Unggah dokumen &amp; warta</strong> — Technical Handbook &amp; berkas pendukung di <a href="javascript:void(0)" onclick="openAdminTab('unduhan')" class="text-warning">Unduhan</a> &amp; <a href="javascript:void(0)" onclick="openAdminTab('berita')" class="text-warning">Berita</a>.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="vstack gap-4 h-100">
            <div class="sthac-card p-4">
              <h5 class="font-display fw-bold text-uppercase text-white mb-3"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Pintasan</h5>
              <div class="d-flex flex-wrap gap-2">
                <button type="button" onclick="openAdminTab('pendaftar')" class="btn btn-sm btn-gold-pill px-3 py-2">Periksa pendaftar</button>
                <button type="button" onclick="openAdminTab('penilaian')" class="btn btn-sm btn-dark-pill px-3 py-2">Input hasil run</button>
                <button type="button" onclick="openAdminTab('acara')" class="btn btn-sm btn-dark-pill px-3 py-2">Seri &amp; kelas</button>
                <button type="button" onclick="openAdminTab('poin')" class="btn btn-sm btn-dark-pill px-3 py-2">Poin &amp; juara</button>
                <button type="button" onclick="openAdminTab('panitia')" class="btn btn-sm btn-dark-pill px-3 py-2">Panitia &amp; juri</button>
                <button type="button" onclick="openAdminTab('unduhan')" class="btn btn-sm btn-dark-pill px-3 py-2">Dokumen</button>
                <a href="/skor" target="_blank" class="btn btn-sm btn-dark-pill px-3 py-2">Lihat papan skor publik &nearr;</a>
                <a href="/juara" target="_blank" class="btn btn-sm btn-dark-pill px-3 py-2">Klasemen poin publik &nearr;</a>
              </div>
            </div>

            <div class="sthac-card p-4 flex-grow-1 d-flex flex-column justify-content-between">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-bold text-uppercase text-white-50">STATUS PENDAFTARAN PUBLIK</span>
                <span class="badge-green-soft"><%= setting.registrationOpen ? 'AKTIF' : 'NONAKTIF' %></span>
              </div>
              <div class="d-flex justify-content-between align-items-center my-2">
                <div>
                  <div class="fw-bold text-white fs-5">Saat ini: <span class="text-warning"><%= setting.registrationOpen ? 'DIBUKA' : 'DITUTUP' %></span></div>
                  <small class="text-white-50">Klik tombol di samping untuk mengubah status instan.</small>
                </div>
                <button type="button" onclick="toggleRegistrationStatus(<%= !setting.registrationOpen %>)" class="btn btn-sm <%= setting.registrationOpen ? 'btn-logout-pill' : 'btn-gold-pill' %> px-3 py-2">
                  <%= setting.registrationOpen ? 'Tutup Pendaftaran' : 'Buka Pendaftaran' %>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TABEL SERI KEJUARAAN -->
      <div class="sthac-card p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
          <div>
            <h5 class="font-display fw-bold text-uppercase text-white mb-0">SERI KEJUARAAN</h5>
            <small class="text-white-50">Ringkasan seri dan jumlah kelasnya di STHAC 2026.</small>
          </div>
          <button type="button" onclick="openAdminTab('acara')" class="btn btn-sm btn-forest-pill px-3 py-2">+ Tambah Seri Baru</button>
        </div>
        <div class="table-responsive">
          <table class="table sthac-table mb-0 small">
            <thead>
              <tr>
                <th>SERI</th>
                <th>TANGGAL</th>
                <th>LOKASI</th>
                <th class="text-center">KELAS</th>
                <th class="text-center">PESERTA</th>
                <th>STATUS</th>
                <th class="text-end">AKSI</th>
              </tr>
            </thead>
            <tbody>
              <% seriList.forEach((s, idx) => { %>
                <tr>
                  <td class="fw-bold text-white"><%= s.namaSeri %></td>
                  <td><%= s.tanggalPelaksanaan %></td>
                  <td><%= s.lokasi %></td>
                  <td class="text-center fw-bold"><%= idx === 0 ? kelasList.length : 0 %></td>
                  <td class="text-center fw-bold"><%= idx === 0 ? riderList.length : 0 %></td>
                  <td>
                    <span class="badge rounded-pill <%= s.statusSeri.toLowerCase().includes('buka') ? 'bg-success-subtle text-success' : 'bg-info-subtle text-info' %> px-3 py-1">
                      <%= s.statusSeri %>
                    </span>
                  </td>
                  <td class="text-end">
                    <button type="button" onclick="openAdminTab('acara')" class="btn btn-sm btn-forest-pill px-3">Kelola &rarr;</button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ==================== 2. TAB PENDAFTAR (MANAJEMEN PENDAFTAR RIDER & KLUB) ==================== -->
    <div id="adm-sec-pendaftar" class="admin-section" style="display:none;">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; PESERTA &amp; KLUB &rsaquo; VERIFIKASI PENDAFTAR</div>
          <h2 class="font-display fw-bold text-white mb-1">Manajemen Pendaftar Rider &amp; Klub</h2>
          <p class="small text-white-50 mb-0">Tinjau berkas formulir pendaftaran online, verifikasi kelayakan kelas/kuda, dan setujui (ACC) agar otomatis masuk ke direktori resmi.</p>
        </div>
        <div class="saiga-kpi-mini d-flex align-items-center gap-3">
          <div>
            <div class="kpi-val"><%= riderList.length + pendaftarList.length %> <small class="fs-6 text-white-50">/ 30 Kuota</small></div>
            <div class="kpi-lbl">Kapasitas Seri 1</div>
          </div>
          <i class="bi bi-pie-chart-fill fs-3 text-warning"></i>
        </div>
      </div>

      <!-- Filter Bar & Live Search Pendaftar -->
      <div class="sthac-card p-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex flex-wrap gap-2">
          <button type="button" onclick="filterPendaftarCards('ALL', this)" class="saiga-filter-chip active">SEMUA (<%= pendaftarList.length + riderList.length %>)</button>
          <button type="button" onclick="filterPendaftarCards('Menunggu', this)" class="saiga-filter-chip">MENUNGGU ACC (<%= stats.menungguAcc %>)</button>
          <button type="button" onclick="filterPendaftarCards('Diterima', this)" class="saiga-filter-chip">DITERIMA (<%= stats.pendaftarDiterima %>)</button>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <input type="text" id="search-pendaftar-inp" oninput="searchPendaftarCards(this.value)" class="form-control form-control-sm sthac-input" style="min-width:230px;" placeholder="Cari nama pendaftar, stable, kota..." />
          <a href="/pendaftaran" target="_blank" class="btn btn-sm btn-gold-pill px-3 py-2 text-nowrap">+ Form Publik</a>
        </div>
      </div>

      <!-- Daftar Kartu Verifikasi Interaktif (Sesuai Screenshot 1 Tengah) -->
      <div class="vstack gap-3" id="pendaftar-cards-container">
        <% const allRegDisplay = pendaftarList.length > 0 ? pendaftarList : riderList.slice(0, 4).map(r => ({ ...r, peranPendaftar: 'Rider', statusVerifikasi: 'Diterima', statusAcc: 'Diterima', isFromRiderTable: true })); %>
        <% allRegDisplay.forEach(p => { %>
          <div class="sthac-card p-4 pendaftar-card-item" data-status="<%= p.statusVerifikasi === 'Diterima' ? 'Diterima' : 'Menunggu' %>" data-search="<%= (p.namaLengkap + ' ' + p.asalStable + ' ' + p.kotaAsal + ' ' + p.kelasPilihan).toLowerCase() %>">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 pb-3 mb-3 border-bottom" style="border-color:var(--border-main) !important;">
              <div class="d-flex align-items-center gap-3">
                <span class="saiga-avatar"><%= (p.namaLengkap || 'R').substring(0,2).toUpperCase() %></span>
                <div>
                  <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h5 class="font-display fw-bold text-uppercase text-white mb-0"><%= p.namaLengkap %></h5>
                    <span class="badge bg-warning text-dark"><%= p.peranPendaftar || 'Rider' %></span>
                    <span class="badge <%= p.statusVerifikasi === 'Diterima' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-dark' %>">
                      <%= p.statusVerifikasi %>
                    </span>
                  </div>
                  <small class="text-white-50">Kode: <strong class="font-monospace text-warning"><%= p.kodeRider || ('REG-' + p.id) %></strong> · Kota: <%= p.kotaAsal %></small>
                </div>
              </div>
              <span class="small text-white-50"><i class="bi bi-clock me-1"></i> Seri 1 · Saiga Stable Arena</span>
            </div>

            <div class="row g-3 small mb-3">
              <div class="col-6 col-md-3">
                <div class="text-white-50" style="font-size:0.7rem;">GENDER &amp; USIA</div>
                <div class="fw-bold text-white"><%= p.gender %> · <%= p.umur %> Tahun (<%= p.kategoriUmur || 'Terbuka' %>)</div>
              </div>
              <div class="col-6 col-md-3">
                <div class="text-white-50" style="font-size:0.7rem;">KELAS DIPILIH</div>
                <div class="fw-bold text-warning"><%= p.kelasPilihan || 'Beginner (Walk)' %></div>
              </div>
              <div class="col-6 col-md-3">
                <div class="text-white-50" style="font-size:0.7rem;">ASAL STABLE &amp; PELATIH</div>
                <div class="fw-bold text-white"><%= p.asalStable %> (<%= p.namaPelatih || '-' %>)</div>
              </div>
              <div class="col-6 col-md-3">
                <div class="text-white-50" style="font-size:0.7rem;">KONTAK WHATSAPP</div>
                <div class="fw-bold text-white font-monospace"><%= p.noWhatsapp %></div>
              </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top" style="border-color:var(--border-main) !important;">
              <div class="small text-white-50">
                <i class="bi bi-shield-check text-success me-1"></i> Verifikasi otomatis menambahkan profil ke Direktori Rider, Pelatih &amp; Stable.
              </div>
              <div class="d-flex gap-2">
                <% if (p.statusVerifikasi !== 'Diterima') { %>
                  <button type="button" onclick="approveReg(<%= p.id %>)" class="btn btn-sm btn-forest-pill px-4 py-2">
                    <i class="bi bi-check2-circle me-1 text-warning"></i> Setujui (ACC)
                  </button>
                <% } else { %>
                  <span class="badge-green-soft py-2 px-3"><i class="bi bi-check-all me-1"></i> Sudah Terverifikasi Resmi</span>
                <% } %>
                <% if (!p.isFromRiderTable) { %>
                  <button type="button" onclick="rejectReg(<%= p.id %>)" class="btn btn-sm btn-logout-pill px-3 py-2">
                    <i class="bi bi-x-circle me-1"></i> Tolak / Hapus
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- ==================== 3. TAB DATA RIDER (SPLIT-SCREEN INTERAKTIF SESUAI SCREENSHOT 2 KIRI) ==================== -->
    <div id="adm-sec-rider" class="admin-section" style="display:none;">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; PESERTA &amp; KLUB &rsaquo; DATA RIDER</div>
          <h2 class="font-display fw-bold text-white mb-1">Kelola &amp; Entri Data Rider Resmi</h2>
          <p class="small text-white-50 mb-0">Input manual rider baru atau perbarui profil atlet yang tampil di halaman publik &amp; papan skor live.</p>
        </div>
        <div class="d-flex gap-2">
          <div class="saiga-kpi-mini text-center"><div class="kpi-val"><%= riderList.length %></div><div class="kpi-lbl">Rider Aktif</div></div>
          <div class="saiga-kpi-mini text-center"><div class="kpi-val">2</div><div class="kpi-lbl">Kategori</div></div>
          <div class="saiga-kpi-mini text-center"><div class="kpi-val">U14 &amp; Open</div><div class="kpi-lbl">Kelas Usia</div></div>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <!-- Kolom Kiri: Form Tambah / Edit Rider -->
        <div class="col-lg-5">
          <div class="sthac-card p-4 h-100" id="card-form-rider">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="d-flex align-items-center gap-2">
                <span class="saiga-avatar"><i class="bi bi-person-plus-fill"></i></span>
                <div>
                  <h6 class="font-display fw-bold text-uppercase text-white mb-0" id="title-form-rider">TAMBAH RIDER MANUAL</h6>
                  <small class="text-white-50" style="font-size:0.7rem;">Formulir Entri Atlet Resmi</small>
                </div>
              </div>
              <span class="badge-green-soft" id="badge-mode-rider">MODE TAMBAH</span>
            </div>

            <form id="form-crud-rider" onsubmit="submitEntityForm(event, 'rider')">
              <input type="hidden" name="id" id="inp-rider-id" value="" />
              <div class="row g-2 mb-2">
                <div class="col-7">
                  <label class="small fw-bold text-warning mb-1">NAMA LENGKAP RIDER *</label>
                  <input type="text" name="namaLengkap" id="inp-rider-nama" class="form-control sthac-input" placeholder="Nama lengkap atlet..." required />
                </div>
                <div class="col-5">
                  <label class="small fw-bold text-warning mb-1">KODE RIDER</label>
                  <input type="text" name="kodeRider" id="inp-rider-kode" class="form-control sthac-input" placeholder="Otomatis" />
                </div>
              </div>

              <div class="row g-2 mb-2">
                <div class="col-4">
                  <label class="small fw-bold text-warning mb-1">GENDER</label>
                  <select name="gender" id="inp-rider-gender" class="form-select sthac-input">
                    <option value="Putra">Putra</option>
                    <option value="Putri">Putri</option>
                  </select>
                </div>
                <div class="col-4">
                  <label class="small fw-bold text-warning mb-1">UMUR (THN)</label>
                  <input type="number" name="umur" id="inp-rider-umur" value="15" min="5" max="75" class="form-control sthac-input" />
                </div>
                <div class="col-4">
                  <label class="small fw-bold text-warning mb-1">KATEGORI</label>
                  <input type="hidden" name="kategori" id="inp-rider-kategori" value="U14" />
                  <div class="sthac-multi-check-group" id="adm-kat-group">
                    <label class="sthac-check-pill py-1 px-2">
                      <input type="checkbox" class="chk-adm-kat" value="U14" checked onchange="syncAdmKatAndKelas()" />
                      <span>U14</span>
                    </label>
                    <label class="sthac-check-pill py-1 px-2">
                      <input type="checkbox" class="chk-adm-kat" value="Terbuka" onchange="syncAdmKatAndKelas()" />
                      <span>Terbuka</span>
                    </label>
                  </div>
                </div>
              </div>

              <div class="row g-2 mb-2">
                <div class="col-6">
                  <div class="mb-3">
                <label class="small fw-bold mb-1">KELAS PERTANDINGAN DIIKUTI (BISA PILIH &gt; 1 KELAS)</label>
                <input type="hidden" name="kelasYangDiikuti" id="inp-rider-kelas" value="Beginner ( Walk ) · U14" />
                <div class="sthac-multi-check-group" id="adm-kelas-group">
                  <% const admListKls = (typeof kelasList !== 'undefined' && kelasList && kelasList.length > 0) ? kelasList : [{ namaKelas: 'Beginner ( Walk ) · U14' }, { namaKelas: 'Beginner ( Trot ) · Terbuka' }]; %>
                  <% admListKls.forEach((k, idx) => { %>
                    <label class="sthac-check-pill">
                      <input type="checkbox" class="chk-adm-kls" value="<%= k.namaKelas %>" <%= idx === 0 ? 'checked' : '' %> onchange="syncAdmKatAndKelas()" />
                      <span><%= k.namaKelas %></span>
                    </label>
                  <% }) %>
                </div>
              </div>
              <label class="small fw-bold text-warning mb-1">ASAL STABLE / KLUB *</label>
                  <input type="text" name="asalStable" id="inp-rider-stable" class="form-control sthac-input" placeholder="Saiga Stable" required />
                </div>
                <div class="col-6">
                  <label class="small fw-bold text-warning mb-1">NAMA PELATIH</label>
                  <input type="text" name="namaPelatih" id="inp-rider-pelatih" class="form-control sthac-input" placeholder="Coach..." />
                </div>
              </div>

              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label class="small fw-bold text-warning mb-1">KOTA ASAL</label>
                  <input type="text" name="kotaAsal" id="inp-rider-kota" value="Tangerang Selatan" class="form-control sthac-input" />
                </div>
                <div class="col-6">
                  <label class="small fw-bold text-warning mb-1">NO. WHATSAPP</label>
                  <input type="text" name="noWhatsapp" id="inp-rider-wa" class="form-control sthac-input" placeholder="0812..." />
                </div>
              </div>

              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold"><i class="bi bi-plus-circle me-1"></i> Simpan Rider</button>
                <button type="button" onclick="resetEntityForm('form-crud-rider', 'inp-rider-id', 'title-form-rider', 'TAMBAH RIDER MANUAL')" class="btn btn-dark-pill px-3 py-2">Reset</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Kolom Kanan: Direktori & Filter Interaktif Rider -->
        <div class="col-lg-7">
          <div class="sthac-card p-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
              <h6 class="font-display fw-bold text-uppercase text-white mb-0">DAFTAR RIDER RESMI (<%= riderList.length %>)</h6>
              <input type="text" oninput="filterTableRows('table-dir-rider', this.value)" class="form-control form-control-sm sthac-input" style="max-width:240px;" placeholder="Cari nama, kode, stable..." />
            </div>

            <div class="d-flex flex-wrap gap-1 mb-3">
              <button type="button" onclick="filterTableRows('table-dir-rider', '')" class="saiga-filter-chip active">Semua (<%= riderList.length %>)</button>
              <button type="button" onclick="filterTableRows('table-dir-rider', 'saiga')" class="saiga-filter-chip">Saiga Stable</button>
              <button type="button" onclick="filterTableRows('table-dir-rider', 'winning')" class="saiga-filter-chip">Winning Academy</button>
              <button type="button" onclick="filterTableRows('table-dir-rider', 'u14')" class="saiga-filter-chip">U14</button>
              <button type="button" onclick="filterTableRows('table-dir-rider', 'terbuka')" class="saiga-filter-chip">Terbuka</button>
            </div>

            <div class="table-responsive">
              <table class="table sthac-table mb-0 small" id="table-dir-rider">
                <thead>
                  <tr>
                    <th>KODE</th>
                    <th>NAMA RIDER</th>
                    <th>KATEGORI</th>
                    <th>STABLE</th>
                    <th class="text-end">AKSI</th>
                  </tr>
                </thead>
                <tbody>
                  <% riderList.forEach(r => { %>
                    <tr>
                      <td class="font-monospace fw-bold text-warning"><%= r.kodeRider %></td>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <span class="saiga-avatar" style="width:28px;height:28px;font-size:0.7rem;"><%= (r.namaLengkap || 'R').substring(0,2).toUpperCase() %></span>
                          <div>
                            <div class="fw-bold text-white"><%= r.namaLengkap %></div>
                            <small class="text-white-50" style="font-size:0.68rem;"><%= r.gender %> · <%= r.umur %> thn · <%= r.kotaAsal %></small>
                          </div>
                        </div>
                      </td>
                      <td><span class="badge-gold-outline"><%= r.kategoriUmur %></span></td>
                      <td><span class="badge-green-soft"><%= r.asalStable %></span></td>
                      <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-dark-pill px-2 py-1 me-1"
                          onclick='fillRiderEdit(<%- JSON.stringify({ id: r.id, kodeRider: r.kodeRider, namaLengkap: r.namaLengkap, gender: r.gender, umur: r.umur, kategoriUmur: r.kategoriUmur, asalStable: r.asalStable, namaPelatih: r.namaPelatih, kotaAsal: r.kotaAsal, noWhatsapp: r.noWhatsapp }) %>)'>
                          <i class="bi bi-pencil"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-logout-pill px-2 py-1" onclick="deleteEntity('rider', <%= r.id %>, '<%= r.namaLengkap %>')">
                          <i class="bi bi-trash"></i>
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="sthac-card p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="small"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Sinkronisasi Ekosistem IHAA &amp; Pordasi Aktif:</strong> Setiap profil rider otomatis terhubung dengan dropdown penilaian run dan direktori publik.</div>
        <a href="/profile" target="_blank" class="btn btn-sm btn-dark-pill px-3">Lihat Direktori Publik &nearr;</a>
      </div>
    </div>

    <!-- ==================== 4. TAB DATA PELATIH (SPLIT-SCREEN INTERAKTIF SESUAI SCREENSHOT 2 TENGAH) ==================== -->
    <div id="adm-sec-pelatih" class="admin-section" style="display:none;">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; PESERTA &amp; KLUB &rsaquo; DATA PELATIH</div>
          <h2 class="font-display fw-bold text-white mb-1">Kelola &amp; Entri Data Pelatih Resmi</h2>
          <p class="small text-white-50 mb-0">Registrasi dan pemutakhiran data pelatih pendamping kontingen stable di STHAC 2026.</p>
        </div>
        <div class="d-flex gap-2">
