<div class="container py-4">

  <!-- ==================== GERBANG LOGIN PANITIA (EMAIL OTP SEKALI PAKAI & SANDI) ==================== -->
  <div id="admin-auth-gate" class="col-md-10 col-lg-6 mx-auto my-4" style="display:none;">
    <div class="sthac-card p-4 p-md-5 animate-up">
      <div class="text-center mb-4">
        <img src="<%= setting.logoUrl %>" alt="STHAC" style="width:68px;height:68px;object-fit:contain;" class="mb-2" />
        <h3 class="font-display fw-bold text-uppercase text-white mb-1">Panel Panitia · STHAC 2026</h3>
        <p class="small text-white-50 mb-0">Masuk atau daftar menggunakan Kode Unik Sekali Pakai (OTP) via Email.</p>
      </div>

      <!-- Pilihan Mode Autentikasi -->
      <div class="d-flex flex-wrap gap-2 p-1 rounded-4 mb-4" style="background:rgba(0,0,0,0.45);border:1px solid rgba(217,180,92,0.28);">
        <button type="button" id="tab-auth-otp" onclick="switchAuthTab('otp')" class="btn btn-gold-pill flex-grow-1 py-2 small">
          <i class="bi bi-envelope-check-fill me-1"></i> Login Email OTP
        </button>
        <button type="button" id="tab-auth-reg" onclick="switchAuthTab('reg')" class="btn btn-dark-pill flex-grow-1 py-2 small">
          <i class="bi bi-person-plus-fill me-1"></i> Daftar Panitia (OTP)
        </button>
        <button type="button" id="tab-auth-pass" onclick="switchAuthTab('pass')" class="btn btn-dark-pill flex-grow-1 py-2 small">
          <i class="bi bi-key-fill me-1"></i> Sandi Cepat
        </button>
      </div>

      <!-- MODE 1: LOGIN DENGAN EMAIL OTP SEKALI PAKAI -->
      <form id="form-auth-otp" onsubmit="handleReqLoginOtp(event)" class="vstack gap-3">
        <div>
          <label class="small text-warning fw-bold mb-1">EMAIL PANITIA / JURI TERDAFTAR *</label>
          <input type="email" name="email" required value="mardiansyah@sthac.com" class="form-control sthac-input py-2" placeholder="Masukkan email panitia..." />
        </div>
        <button type="submit" class="btn btn-gold-pill w-100 py-3">
          <i class="bi bi-send-fill me-1"></i> Kirim Kode OTP Sekali Pakai ke Email
        </button>
        <div class="p-3 rounded-3 small text-white-50" style="background:rgba(255,255,255,0.03);border:1px solid rgba(217,180,92,0.2);">
          <strong class="text-gold-bright d-block mb-1">Akun Panitia Terdaftar (Siap Uji OTP):</strong>
          • Juri Utama: <code class="text-warning">mardiansyah@sthac.com</code><br/>
          • Scorer/Pencatat: <code class="text-warning">andi@sthac.com</code>
        </div>
      </form>

      <!-- MODE 2: DAFTAR PANITIA BARU DENGAN VERIFIKASI OTP EMAIL -->
      <form id="form-auth-reg" onsubmit="handleReqRegOtp(event)" class="row g-3 small" style="display:none;">
        <div class="col-md-6"><label class="text-warning fw-bold mb-1">NAMA LENGKAP *</label><input name="namaLengkap" required class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">NAMA PANGGILAN *</label><input name="panggilan" required class="form-control sthac-input" /></div>
        <div class="col-md-6">
          <label class="text-white-50 mb-1">PERAN KEPANITIAAN</label>
          <select name="peran" class="form-select sthac-input">
            <option>Juri Utama</option><option>Juri</option><option>Scorer/Pencatat</option><option>Timer</option><option>Course Designer</option><option>Starter</option><option>Tim Medis</option>
          </select>
        </div>
        <div class="col-md-6"><label class="text-white-50 mb-1">SERTIFIKASI / LISENSI</label><input name="sertif" class="form-control sthac-input" placeholder="Juri Berkuda Memanah" /></div>
        <div class="col-md-6"><label class="text-white-50 mb-1">KONTAK / WHATSAPP</label><input name="kontakWa" class="form-control sthac-input" /></div>
        <div class="col-md-6"><label class="text-warning fw-bold mb-1">EMAIL AKTIF (PENERIMA OTP) *</label><input type="email" name="email" required class="form-control sthac-input border-warning" /></div>
        <div class="col-12"><label class="text-white-50 mb-1">BIO / TUGAS</label><input name="bioTugas" class="form-control sthac-input" /></div>
        <div class="col-12 mt-3">
          <button type="submit" class="btn btn-gold-pill w-100 py-3">Daftar &amp; Kirim Kode OTP Verifikasi ke Email</button>
        </div>
      </form>

      <!-- MODE 3: LOGIN SANDI PANITIA (sthac2026) -->
      <form id="form-auth-pass" onsubmit="handlePassLogin(event)" class="vstack gap-3" style="display:none;">
        <div>
          <label class="small text-warning fw-bold mb-1">KATA SANDI PANITIA *</label>
          <input type="password" name="password" required value="sthac2026" class="form-control sthac-input py-2" />
          <small class="text-white-50">Default sandi sesuai sthac.com: <code class="text-warning">sthac2026</code></small>
        </div>
        <button type="submit" class="btn btn-gold-pill w-100 py-3">Masuk Panel Panitia</button>
      </form>

      <!-- FORM VERIFIKASI 6 DIGIT KODE OTP SEKALI PAKAI -->
      <form id="form-otp-verify" onsubmit="handleVerifyOtp(event)" class="vstack gap-3 mt-2" style="display:none;">
        <div class="p-3 rounded-4" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.4);">
          <div class="text-success fw-bold small mb-1"><i class="bi bi-check-circle-fill me-1"></i> Kode Unik OTP Telah Dikirim ke Email!</div>
          <div class="small text-white-50">Email tujuan: <strong id="lbl-otp-email" class="text-white"></strong></div>

        </div>
        <div>
          <label class="small text-warning fw-bold mb-1">MASUKKAN 6 DIGIT KODE OTP *</label>
          <input type="text" id="inp-otp-code" required maxlength="6" class="form-control sthac-input py-3 text-center font-monospace fw-bold fs-4 text-gold" style="letter-spacing:8px;" />
        </div>
        <button type="submit" class="btn btn-gold-pill w-100 py-3">Verifikasi Kode OTP &amp; Masuk</button>
      </form>
    </div>
  </div>

  <!-- ==================== AREA KERJA PANEL PANITIA (13 MENU LENGKAP) ==================== -->
  <div id="admin-workspace" style="display:none;">

            <!-- SUB-NAVBAR PANEL PANITIA (MERGED, SOLID DROPDOWN & PENEMPATAN TOMBOL KELUAR RAPI) -->
    <div class="admin-navbar-card p-3 mb-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        
        <!-- Kiri: Identitas Panel Panitia -->
        <div class="d-flex align-items-center gap-3">
          <img src="<%= setting.logoUrl %>" alt="Logo" style="width:42px;height:42px;object-fit:contain;" />
          <div>
            <span class="font-display fw-bold text-uppercase text-white d-block lh-1" style="font-size:1.05rem;letter-spacing:0.8px;">PANEL PANITIA</span>
            <small class="text-white-50 d-block mt-1" style="font-size:0.72rem;">South Tangerang Horseback Archery Cup</small>
          </div>
        </div>

        <!-- Tengah: Kelompok Navigasi Utama (Merged) -->
        <div class="d-flex flex-wrap gap-2 align-items-center" id="admin-nav-pills">
          <!-- 1. Ringkasan -->
          <button type="button" id="adm-group-ringkasan" onclick="openAdminTab('ringkasan')" class="btn btn-sm btn-gold-pill py-2 px-3">
            <i class="bi bi-speedometer2 me-1"></i> Ringkasan
          </button>

          <!-- 2. Peserta & Klub -->
          <div class="dropdown">
            <button type="button" id="adm-group-peserta" class="btn btn-sm btn-dark-pill dropdown-toggle py-2 px-3" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-people-fill me-1"></i> Peserta &amp; Klub
            </button>
            <ul class="dropdown-menu dropdown-menu-sthac">
              <li><a class="dropdown-item adm-sub-link" data-tab="pendaftar" href="#" onclick="openAdminTab('pendaftar'); return false;"><i class="bi bi-person-check-fill me-2 text-warning"></i> Pendaftar (<%= stats.menungguAcc %> Pending)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="rider" href="#" onclick="openAdminTab('rider'); return false;"><i class="bi bi-person-badge-fill me-2 text-warning"></i> Data Rider</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="pelatih" href="#" onclick="openAdminTab('pelatih'); return false;"><i class="bi bi-person-workspace me-2 text-warning"></i> Data Pelatih</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="stable" href="#" onclick="openAdminTab('stable'); return false;"><i class="bi bi-shield-shaded me-2 text-warning"></i> Data Stable</a></li>
            </ul>
          </div>

          <!-- 3. Teknis & Penilaian -->
          <div class="dropdown">
            <button type="button" id="adm-group-teknis" class="btn btn-sm btn-dark-pill dropdown-toggle py-2 px-3" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-trophy-fill me-1"></i> Teknis &amp; Penilaian
            </button>
            <ul class="dropdown-menu dropdown-menu-sthac">
              <li><a class="dropdown-item adm-sub-link" data-tab="acara" href="#" onclick="openAdminTab('acara'); return false;"><i class="bi bi-calendar-range-fill me-2 text-warning"></i> Seri &amp; Kelas</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="lintasan" href="#" onclick="openAdminTab('lintasan'); return false;"><i class="bi bi-signpost-split-fill me-2 text-warning"></i> Master Lintasan</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="penilaian" href="#" onclick="openAdminTab('penilaian'); return false;"><i class="bi bi-stopwatch-fill me-2 text-danger"></i> Input Penilaian Run</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="poin" href="#" onclick="openAdminTab('poin'); return false;"><i class="bi bi-award-fill me-2 text-warning"></i> Poin &amp; Juara Umum</a></li>
            </ul>
          </div>

          <!-- 4. Sistem & Konten -->
          <div class="dropdown">
            <button type="button" id="adm-group-sistem" class="btn btn-sm btn-dark-pill dropdown-toggle py-2 px-3" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-Sliders me-1"></i> Sistem &amp; Konten
            </button>
            <ul class="dropdown-menu dropdown-menu-sthac">
              <li><a class="dropdown-item adm-sub-link" data-tab="panitia" href="#" onclick="openAdminTab('panitia'); return false;"><i class="bi bi-person-vcard-fill me-2 text-warning"></i> Panitia &amp; Juri</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="unduhan" href="#" onclick="openAdminTab('unduhan'); return false;"><i class="bi bi-file-earmark-arrow-down-fill me-2 text-warning"></i> Unduhan Dokumen</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="berita" href="#" onclick="openAdminTab('berita'); return false;"><i class="bi bi-newspaper me-2 text-warning"></i> Berita &amp; Warta</a></li>
            </ul>
          </div>
        </div>

        <!-- Kanan: Tombol Setelan & Tombol Keluar Terpisah Rapi -->
        <div class="d-flex align-items-center gap-2 ms-auto ms-xl-0 ps-xl-3 border-start border-secondary border-opacity-25">
          <button type="button" id="adm-group-setelan" onclick="openAdminTab('setelan')" class="btn btn-sm btn-dark-pill py-2 px-3" title="Pengaturan Situs">
            <i class="bi bi-gear-fill text-warning me-1"></i> Setelan
          </button>
          <button type="button" onclick="logoutAdmin()" class="btn btn-sm btn-logout-pill py-2 px-3">
            <i class="bi bi-box-arrow-right me-1"></i> Keluar
          </button>
        </div>

      </div>
    </div>

    <!-- ==================== 1. TAB RINGKASAN (admin.php) ==================== -->
    <div id="adm-sec-ringkasan" class="admin-section">
      <div class="p-3 rounded-4 mb-4 small fw-semibold text-white" style="background:rgba(16,185,129,0.14);border:1px solid rgba(16,185,129,0.35);">
        Selamat datang, <span id="lbl-admin-user">Panitia STHAC</span>.
      </div>

      <h2 class="font-display fw-bold text-uppercase text-white mb-1"><i class="bi bi-bar-chart-fill text-warning me-2"></i>RINGKASAN PANITIA</h2>
      <p class="text-white-50 small mb-4">Kelola pendaftaran, peserta, kelas, dan hasil penilaian kejuaraan.</p>

      <div class="sthac-card p-3 p-md-4 mb-4" style="border-color:rgba(217,180,92,0.4);">
        <span class="small text-white-50">
          Database masih memuat <strong class="text-white">data contoh</strong> (rider, pelatih, stable, panitia, dokumen, dan satu seri uji coba beserta hasilnya). Data ini hanya untuk memperlihatkan tampilan. Hapus setelah data asli mulai masuk:
        </span>
        <button onclick="clearDemo()" class="btn btn-sm btn-danger rounded-pill px-3 ms-2 fw-bold">Hapus data contoh</button>
      </div>

      <!-- 8 Kartu Statistik -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2"><div class="sthac-stat-card"><div class="fs-3 fw-bold font-display text-gold"><%= stats.menungguAcc %></div><div class="small text-white-50 text-uppercase">Pendaftar Menunggu ACC</div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="sthac-stat-card"><div class="fs-3 fw-bold font-display text-gold"><%= stats.diterima %></div><div class="small text-white-50 text-uppercase">Pendaftar Diterima</div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="sthac-stat-card"><div class="fs-3 fw-bold font-display text-gold"><%= stats.riderAktif %></div><div class="small text-white-50 text-uppercase">Rider Aktif</div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="sthac-stat-card"><div class="fs-3 fw-bold font-display text-gold"><%= stats.pelatih %></div><div class="small text-white-50 text-uppercase">Pelatih</div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="sthac-stat-card"><div class="fs-3 fw-bold font-display text-gold"><%= stats.stable %></div><div class="small text-white-50 text-uppercase">Stable</div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="sthac-stat-card"><div class="fs-3 fw-bold font-display text-gold"><%= stats.hasilRun %></div><div class="small text-white-50 text-uppercase">Hasil Run Tersimpan</div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="sthac-stat-card"><div class="fs-3 fw-bold font-display text-gold"><%= stats.panitiaJuri %></div><div class="small text-white-50 text-uppercase">Panitia &amp; Juri</div></div></div>
        <div class="col-6 col-md-4 col-xl-2"><div class="sthac-stat-card"><div class="fs-3 fw-bold font-display text-gold"><%= stats.dokumen %></div><div class="small text-white-50 text-uppercase">Dokumen Unduhan</div></div></div>
      </div>

      <!-- Langkah Pengelolaan & Pintasan -->
      <div class="row g-4 mb-4">
        <div class="col-lg-6">
          <div class="sthac-card p-4 h-100">
            <h5 class="font-display fw-bold text-uppercase text-white mb-3"><i class="bi bi-compass text-warning me-2"></i>LANGKAH PENGELOLAAN</h5>
            <ol class="small text-white-50 vstack gap-2 mb-0 ps-3">
              <li><strong class="text-white">Verifikasi pendaftar</strong> — setujui rider/pelatih/stable dari halaman <a href="#" onclick="openAdminTab('pendaftar');return false;" class="text-warning">Pendaftar</a>.</li>
              <li><strong class="text-white">Atur seri &amp; kelas</strong> — tanggal, lintasan, jumlah run dinilai di halaman <a href="#" onclick="openAdminTab('acara');return false;" class="text-warning">Seri &amp; Kelas</a>.</li>
              <li><strong class="text-white">Daftarkan peserta ke kelas</strong> — dari halaman <a href="#" onclick="openAdminTab('penilaian');return false;" class="text-warning">Penilaian</a> atau <a href="#" onclick="openAdminTab('rider');return false;" class="text-warning">Rider</a>.</li>
              <li><strong class="text-white">Masukkan hasil tiap run</strong> — skor dihitung otomatis; papan skor publik langsung diperbarui.</li>
              <li><strong class="text-white">Periksa klasemen poin</strong> — poin juara umum dihitung otomatis di <a href="#" onclick="openAdminTab('poin');return false;" class="text-warning">Poin &amp; Juara</a>.</li>
              <li><strong class="text-white">Unggah dokumen</strong> — Technical Handbook &amp; berkas pendukung di <a href="#" onclick="openAdminTab('unduhan');return false;" class="text-warning">Unduhan</a>.</li>
            </ol>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="sthac-card p-4 h-100 d-flex flex-column justify-content-between">
            <div>
              <h5 class="font-display fw-bold text-uppercase text-white mb-3"><i class="bi bi-lightning-charge text-warning me-2"></i>PINTASAN</h5>
              <div class="d-flex flex-wrap gap-2 mb-4">
                <button onclick="openAdminTab('pendaftar')" class="btn btn-gold-pill btn-sm">Periksa pendaftar</button>
                <button onclick="openAdminTab('penilaian')" class="btn btn-dark-pill btn-sm">Input hasil run</button>
                <button onclick="openAdminTab('acara')" class="btn btn-dark-pill btn-sm">Seri &amp; kelas</button>
                <button onclick="openAdminTab('poin')" class="btn btn-dark-pill btn-sm">Poin &amp; juara</button>
                <button onclick="openAdminTab('panitia')" class="btn btn-dark-pill btn-sm">Panitia &amp; juri</button>
                <button onclick="openAdminTab('unduhan')" class="btn btn-dark-pill btn-sm">Dokumen</button>
                <a href="/skor" class="btn btn-dark-pill btn-sm">Lihat papan skor publik</a>
                <a href="/juara" class="btn btn-dark-pill btn-sm">Klasemen poin publik</a>
              </div>
            </div>
            <div class="pt-3 border-top border-secondary border-opacity-25">
              <h6 class="font-display fw-bold text-uppercase text-white mb-1">STATUS PENDAFTARAN PUBLIK</h6>
              <p class="small text-white-50 mb-0">
                Saat ini: <strong class="text-gold"><%= setting.registrationOpen ? 'DIBUKA' : 'DITUTUP' %></strong>. Ubah di <a href="#" onclick="openAdminTab('setelan');return false;" class="text-warning">Pengaturan</a>.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Tabel Seri Kejuaraan -->
      <div class="sthac-card p-4">
        <h4 class="font-display fw-bold text-uppercase text-white mb-1">SERI KEJUARAAN</h4>
        <p class="small text-white-50 mb-3">Ringkasan seri dan jumlah kelasnya.</p>
        <div class="table-responsive">
          <table class="table table-dark sthac-table mb-0">
            <thead><tr><th>SERI</th><th>TANGGAL</th><th>LOKASI</th><th class="text-center">KELAS</th><th class="text-center">PESERTA</th><th>STATUS</th><th class="text-end"></th></tr></thead>
            <tbody>
              <% seriList.forEach(s => { %>
                <tr>
                  <td class="fw-bold text-white"><%= s.namaSeri %></td>
                  <td class="text-white-50"><%= s.tanggalTampil %></td>
                  <td class="text-white-50"><%= s.tempat %></td>
                  <td class="text-center"><%= s.kelasList ? s.kelasList.length : 0 %></td>
                  <td class="text-center"><%= s.nomorSeri === 1 ? stats.diterima : 0 %></td>
                  <td><span class="badge rounded-pill px-3 py-1 <%= s.status.toLowerCase().includes('dibuka') ? 'bg-success-subtle text-success' : 'bg-info-subtle text-info' %>"><%= s.status %></span></td>
                  <td class="text-end"><button onclick="openAdminTab('acara')" class="btn btn-dark-pill btn-sm">Kelola</button></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ==================== 2. TAB PENDAFTAR (admin-pendaftar.php) ==================== -->
    <div id="adm-sec-pendaftar" class="admin-section" style="display:none;">
      <div class="d-flex flex-wrap gap-2 mb-4">
        <button onclick="filterRegistrant('Pending')" class="btn btn-gold-pill btn-sm">MENUNGGU ACC (<%= stats.menungguAcc %>)</button>
        <button onclick="filterRegistrant('Diterima')" class="btn btn-dark-pill btn-sm">DITERIMA (<%= stats.diterima %>)</button>
        <button onclick="filterRegistrant('Ditolak')" class="btn btn-dark-pill btn-sm">DITOLAK (<%= stats.ditolak %>)</button>
        <button onclick="filterRegistrant('all')" class="btn btn-dark-pill btn-sm">SEMUA (<%= stats.semuaPendaftar %>)</button>
      </div>

      <div class="vstack gap-4">
        <% adminBundle.allRiders.forEach(r => { %>
          <div class="sthac-card p-4 reg-card-item" data-status="<%= r.statusAcc %>">
            <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
              <div>
                <h4 class="font-display fw-bold text-uppercase text-white d-inline me-2"><%= r.namaLengkap %></h4>
                <span class="badge rounded-pill bg-success-subtle text-success">RIDER</span>
                <div class="small text-white-50 mt-1">Pendaftaran #<%= r.noBib %> · Kamis, 22 Oktober 2026 04:02</div>
              </div>
              <span class="badge rounded-pill px-3 py-2 <%= r.statusAcc === 'Pending' ? 'bg-warning text-dark' : (r.statusAcc === 'Diterima' ? 'bg-success' : 'bg-danger') %>">
                <%= r.statusAcc.toUpperCase() %>
              </span>
            </div>

            <div class="row g-3 small text-white-50 mb-4">
              <div class="col-md-6 vstack gap-2">
                <div><i class="bi bi-person text-warning me-2"></i>Panggilan: <strong class="text-white"><%= r.namaPanggilan %></strong></div>
                <div><i class="bi bi-bullseye text-warning me-2"></i>Kelas: <strong class="text-white"><%= r.kelasDiikuti %></strong></div>
                <div><i class="bi bi-award text-warning me-2"></i>Kategori: <strong class="text-white"><%= r.kategori %></strong></div>
                <div><i class="bi bi-shield-shaded text-warning me-2"></i>Asal stable: <strong class="text-white"><%= r.asalStable %></strong></div>
                <div><i class="bi bi-geo-alt text-warning me-2"></i><%= r.kotaKabupaten %></div>
              </div>
              <div class="col-md-6 vstack gap-2">
                <div><i class="bi bi-whatsapp text-success me-2"></i>WhatsApp: <strong class="text-white"><%= r.noWa %></strong></div>
                <div><i class="bi bi-envelope text-warning me-2"></i><strong class="text-white"><%= r.email %></strong></div>
                <div><i class="bi bi-calendar3 text-warning me-2"></i>Lahir: <strong class="text-white"><%= r.formattedDate %></strong> <%= r.ageText %></div>
              </div>
            </div>

            <!-- Form Verifikasi ACC / Tolak -->
            <div class="row g-3 mb-3 pt-3 border-top border-secondary border-opacity-25 small">
              <div class="col-md-5">
