              <div class="mb-2">
                <label class="small fw-bold text-warning mb-1">EMAIL LOGIN OTP *</label>
                <input type="email" name="email" id="inp-panitia-email" class="form-control sthac-input" placeholder="nama@sthac.com" required />
              </div>
              <div class="mb-3">
                <label class="small fw-bold text-warning mb-1">JABATAN KEJUARAAN *</label>
                <input type="text" name="jabatan" id="inp-panitia-jabatan" value="Juri Utama" class="form-control sthac-input" required />
              </div>
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold"><i class="bi bi-save me-1"></i> Simpan Petugas</button>
                <button type="button" onclick="resetEntityForm('form-crud-panitia', 'inp-panitia-id', 'title-form-panitia', 'TAMBAH PANITIA / JURI')" class="btn btn-dark-pill px-3 py-2">Reset</button>
              </div>
            </form>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="sthac-card p-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
              <h6 class="font-display fw-bold text-uppercase text-white mb-0">DAFTAR DEWAN JURI &amp; PANITIA (<%= panitiaList.length %>)</h6>
              <input type="text" oninput="filterTableRows('table-dir-panitia', this.value)" class="form-control form-control-sm sthac-input" style="max-width:220px;" placeholder="Cari nama, jabatan..." />
            </div>

            <div class="table-responsive">
              <table class="table sthac-table mb-0 small" id="table-dir-panitia">
                <thead>
                  <tr>
                    <th>NAMA PETUGAS</th>
                    <th>JABATAN</th>
                    <th>EMAIL OTP</th>
                    <th>STATUS</th>
                    <th class="text-end">AKSI</th>
                  </tr>
                </thead>
                <tbody>
                  <% panitiaList.forEach(u => { %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <span class="saiga-avatar" style="width:28px;height:28px;font-size:0.7rem;"><%= (u.namaLengkap || 'P').substring(0,2).toUpperCase() %></span>
                          <span class="fw-bold text-white"><%= u.namaLengkap %></span>
                        </div>
                      </td>
                      <td><span class="badge-gold-outline"><%= u.jabatan %></span></td>
                      <td class="font-monospace text-warning"><%= u.email %></td>
                      <td><span class="badge-green-soft">Aktif</span></td>
                      <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-dark-pill px-2 py-1 me-1"
                          onclick='fillPanitiaEdit(<%- JSON.stringify({ id: u.id, namaLengkap: u.namaLengkap, email: u.email, jabatan: u.jabatan }) %>)'>
                          <i class="bi bi-pencil"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-logout-pill px-2 py-1" onclick="deleteEntity('panitia', <%= u.id %>, '<%= u.namaLengkap %>')">
                          <i class="bi bi-trash"></i>
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== 11. TAB UNDUHAN DOKUMEN (SPLIT-SCREEN SESUAI SCREENSHOT 3 KANAN) ==================== -->
    <div id="adm-sec-unduhan" class="admin-section" style="display:none;">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; SISTEM &amp; KONTEN &rsaquo; UNDUHAN DOKUMEN</div>
          <h2 class="font-display fw-bold text-white mb-1">Unggah Dokumen Baru &amp; Kelola Berkas Resmi</h2>
          <p class="small text-white-50 mb-0">Manajemen berkas regulasi pertandingan, Technical Handbook (THB), dan formulir pendaftaran manual.</p>
        </div>
        <div class="saiga-kpi-mini text-center"><div class="kpi-val"><%= dokumenList.length %></div><div class="kpi-lbl">Total Berkas</div></div>
      </div>

      <div class="row g-4">
        <div class="col-lg-5">
          <div class="sthac-card p-4 h-100" id="card-form-unduhan">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6 class="font-display fw-bold text-uppercase text-white mb-0" id="title-form-unduhan"><i class="bi bi-cloud-arrow-up-fill text-warning me-2"></i>UNGGAH DOKUMEN BARU</h6>
              <span class="badge-green-soft">PUBLIK</span>
            </div>
            <form id="form-crud-unduhan" onsubmit="submitEntityForm(event, 'unduhan')">
              <input type="hidden" name="id" id="inp-unduhan-id" value="" />
              <div class="mb-2">
                <label class="small fw-bold text-warning mb-1">NAMA / JUDUL DOKUMEN *</label>
                <input type="text" name="judul" id="inp-unduhan-judul" class="form-control sthac-input" placeholder="Contoh: Technical Handbook Seri 1" required />
              </div>
              <div class="row g-2 mb-2">
                <div class="col-4">
                  <label class="small fw-bold text-warning mb-1">KODE BADGE</label>
                  <input type="text" name="kodeBadge" id="inp-unduhan-kode" value="THB" class="form-control sthac-input" required />
                </div>
                <div class="col-8">
                  <label class="small fw-bold text-warning mb-1">KATEGORI BERKAS</label>
                  <input type="text" name="kategori" id="inp-unduhan-kategori" value="Technical Handbook" class="form-control sthac-input" />
                </div>
              </div>
              <div class="mb-3">
                <label class="small fw-bold text-warning mb-1">TAUTAN BERKAS / URL UNDUHAN *</label>
                <input type="text" name="fileUrl" id="inp-unduhan-url" value="/aturan" class="form-control sthac-input" required />
              </div>
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold"><i class="bi bi-save me-1"></i> Simpan Dokumen</button>
                <button type="button" onclick="resetEntityForm('form-crud-unduhan', 'inp-unduhan-id', 'title-form-unduhan', 'UNGGAH DOKUMEN BARU')" class="btn btn-dark-pill px-3 py-2">Reset</button>
              </div>
            </form>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="sthac-card p-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
              <h6 class="font-display fw-bold text-uppercase text-white mb-0">DAFTAR BERKAS RESMI KEJUARAAN (<%= dokumenList.length %>)</h6>
              <input type="text" oninput="filterTableRows('table-dir-unduhan', this.value)" class="form-control form-control-sm sthac-input" style="max-width:220px;" placeholder="Cari judul berkas..." />
            </div>

            <div class="table-responsive">
              <table class="table sthac-table mb-0 small" id="table-dir-unduhan">
                <thead>
                  <tr>
                    <th>KODE</th>
                    <th>JUDUL DOKUMEN</th>
                    <th>KATEGORI</th>
                    <th>STATUS</th>
                    <th class="text-end">AKSI</th>
                  </tr>
                </thead>
                <tbody>
                  <% dokumenList.forEach(d => { %>
                    <tr>
                      <td><span class="badge-amber-soft"><%= d.kodeBadge %></span></td>
                      <td class="fw-bold text-white"><%= d.judul %></td>
                      <td><%= d.kategori %></td>
                      <td><span class="badge-green-soft">Tersedia</span></td>
                      <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-dark-pill px-2 py-1 me-1"
                          onclick='fillUnduhanEdit(<%- JSON.stringify({ id: d.id, kodeBadge: d.kodeBadge, judul: d.judul, kategori: d.kategori, fileUrl: d.fileUrl }) %>)'>
                          <i class="bi bi-pencil"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-logout-pill px-2 py-1" onclick="deleteEntity('unduhan', <%= d.id %>, '<%= d.judul %>')">
                          <i class="bi bi-trash"></i>
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== 12. TAB BERITA & WARTA (SPLIT-SCREEN DENGAN UPLOAD FOTO) ==================== -->
    <div id="adm-sec-berita" class="admin-section" style="display:none;">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; SISTEM &amp; KONTEN &rsaquo; BERITA &amp; WARTA</div>
          <h2 class="font-display fw-bold text-white mb-1">Tulis Berita / Pengumuman &amp; Kelola Warta Resmi</h2>
          <p class="small text-white-50 mb-0">Publikasikan informasi resmi kejuaraan, regulasi teknis, dan rilis pers STHAC 2026 beserta foto dokumentasi ke halaman publik.</p>
        </div>
        <div class="d-flex gap-2">
          <div class="saiga-kpi-mini text-center"><div class="kpi-val">0<%= beritaList.length %></div><div class="kpi-lbl">Total Warta</div></div>
          <div class="saiga-kpi-mini text-center"><div class="kpi-val">100%</div><div class="kpi-lbl">Terpublikasi</div></div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-5">
          <div class="sthac-card p-4 h-100" id="card-form-berita">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6 class="font-display fw-bold text-uppercase text-white mb-0" id="title-form-berita"><i class="bi bi-pencil-square text-warning me-2"></i>TULIS BERITA / PENGUMUMAN</h6>
              <span class="badge-green-soft" id="badge-mode-berita">EDITOR WARTA</span>
            </div>
            <form id="form-crud-berita" onsubmit="submitEntityForm(event, 'berita')">
              <input type="hidden" name="id" id="inp-berita-id" value="" />
              <div class="mb-2">
                <label class="small fw-bold text-warning mb-1">JUDUL BERITA / PENGUMUMAN *</label>
                <input type="text" name="judul" id="inp-berita-judul" class="form-control sthac-input" placeholder="Judul rilis berita resmi..." required />
              </div>
              <div class="row g-2 mb-2">
                <div class="col-6">
                  <label class="small fw-bold text-warning mb-1">KATEGORI WARTA</label>
                  <select name="kategori" id="inp-berita-kategori" class="form-select sthac-input">
                    <option value="Pengumuman">Pengumuman Resmi</option>
                    <option value="Regulasi">Regulasi &amp; Teknis</option>
                    <option value="Liputan Seri">Liputan Seri</option>
                  </select>
                </div>
                <div class="col-6">
                  <label class="small fw-bold text-warning mb-1">TANGGAL TERBIT</label>
                  <input type="text" name="tanggalTerbit" id="inp-berita-tanggal" value="24 Oktober 2026" class="form-control sthac-input" />
                </div>
              </div>
              <div class="mb-3">
                <label class="small fw-bold text-warning mb-1">ISI RINGKASAN / ARTIKEL WARTA *</label>
                <textarea name="ringkasan" id="inp-berita-ringkasan" rows="4" class="form-control sthac-input" placeholder="Tulis isi pengumuman atau berita resmi kejuaraan..." required></textarea>
              </div>

              <!-- INPUT UPLOAD FOTO / THUMBNAIL WARTA -->
              <div class="mb-3">
                <label class="small fw-bold text-warning mb-1">FOTO / GAMBAR WARTA (UPLOAD FILE / URL)</label>
                <div class="row g-2">
                  <div class="col-7">
                    <input type="file" id="inp-berita-file" accept="image/*" onchange="previewBeritaFile(this)" class="form-control form-control-sm sthac-input" />
                  </div>
                  <div class="col-5">
                    <input type="text" name="fotoUrl" id="inp-berita-foto" oninput="updateBeritaPreviewBox(this.value)" class="form-control form-control-sm sthac-input" placeholder="Atau URL foto..." />
                  </div>
                </div>
                <small class="text-white-50 d-block mt-1" style="font-size:0.68rem;">Mendukung JPG, PNG, atau WEBP. Otomatis disimpan ke server.</small>
              </div>

              <!-- KOTAK PRATINJAU FOTO WARTA -->
              <div class="p-2 rounded-3 mb-3 text-center" id="berita-preview-wrap" style="background:var(--bg-table-head); border:1px dashed var(--border-card-hover);">
                <div class="d-flex justify-content-between align-items-center px-2 mb-1">
                  <span class="small text-white-50" style="font-size:0.68rem;">PRATINJAU FOTO WARTA:</span>
                  <button type="button" id="btn-clear-berita-foto" onclick="clearBeritaPhoto()" class="btn btn-link btn-sm text-danger p-0 text-decoration-none d-none" style="font-size:0.7rem;">
                    <i class="bi bi-x-circle me-1"></i>Hapus Foto
                  </button>
                </div>
                <div class="mx-auto d-flex align-items-center justify-content-center rounded-3 overflow-hidden" style="height:115px; max-width:280px; background:rgba(7,38,25,0.06);">
                  <img id="img-berita-preview" src="" alt="Preview Foto Warta" style="max-height:110px; max-width:100%; object-fit:cover; display:none; border-radius:0.5rem;" />
                  <span id="txt-berita-nopreview" class="small text-muted"><i class="bi bi-image me-1"></i>Belum ada foto warta dipilih</span>
                </div>
              </div>

              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold"><i class="bi bi-send-check me-1"></i> Publikasikan Berita</button>
                <button type="button" onclick="resetEntityForm('form-crud-berita', 'inp-berita-id', 'title-form-berita', 'TULIS BERITA / PENGUMUMAN')" class="btn btn-dark-pill px-3 py-2">Reset</button>
              </div>
            </form>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="sthac-card p-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
              <h6 class="font-display fw-bold text-uppercase text-white mb-0">DAFTAR BERITA &amp; PENGUMUMAN RESMI (<%= beritaList.length %>)</h6>
              <input type="text" oninput="filterBeritaCards(this.value)" class="form-control form-control-sm sthac-input" style="max-width:220px;" placeholder="Cari judul berita..." />
            </div>

            <div class="vstack gap-3" id="berita-list-container">
              <% beritaList.forEach(b => { %>
                <% const bPhoto = b.fotoUrl || b.foto || b.gambar || ''; %>
                <div class="p-3 rounded-3 berita-card-item" data-search="<%= (b.judul + ' ' + b.kategori + ' ' + b.ringkasan).toLowerCase() %>" style="background:var(--bg-table-head); border:1px solid var(--border-main);">
                  <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div>
                      <span class="badge-amber-soft me-2"><%= b.kategori %></span>
                      <small class="text-white-50"><i class="bi bi-calendar3 me-1"></i> <%= b.tanggalTerbit %></small>
                    </div>
                    <div class="d-flex gap-1">
                      <button type="button" class="btn btn-sm btn-dark-pill px-2 py-1"
                        onclick='fillBeritaEdit(<%- JSON.stringify({ id: b.id, judul: b.judul, kategori: b.kategori, tanggalTerbit: b.tanggalTerbit, ringkasan: b.ringkasan, fotoUrl: bPhoto }) %>)'>
                        <i class="bi bi-pencil"></i> Edit
                      </button>
                      <button type="button" class="btn btn-sm btn-logout-pill px-2 py-1" onclick="deleteEntity('berita', <%= b.id %>, '<%= b.judul %>')">
                        <i class="bi bi-trash"></i> Hapus
                      </button>
                    </div>
                  </div>
                  <div class="d-flex align-items-start gap-3">
                    <% if (bPhoto) { %>
                      <img src="<%= bPhoto %>" alt="<%= b.judul %>" class="rounded-3 border flex-shrink-0" style="width:88px; height:64px; object-fit:cover;" />
                    <% } %>
                    <div>
                      <h6 class="fw-bold text-white mb-1"><%= b.judul %></h6>
                      <p class="small text-white-50 mb-0"><%= b.ringkasan %></p>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== 12A. TAB RUNDOWN & ATURAN UMUM PERTANDINGAN (OOP MODULE) ==================== -->
    <div id="adm-sec-rundown" class="admin-section" style="display:none;">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; SISTEM &amp; KONTEN &rsaquo; RUNDOWN &amp; ATURAN</div>
          <h2 class="font-display fw-bold text-white mb-1">Kelola Susunan Acara &amp; Aturan Pertandingan</h2>
          <p class="small text-white-50 mb-0">Atur jadwal rundown Hari-H (kolom waktu di sebelah kiri &amp; teks kegiatan di kanan) serta 7 aturan umum pertandingan.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <div class="saiga-kpi-mini text-center">
            <div class="kpi-val" id="kpi-rundown-count">9</div>
            <div class="kpi-lbl">Jadwal Acara</div>
          </div>
          <div class="saiga-kpi-mini text-center">
            <div class="kpi-val" id="kpi-aturan-count">7</div>
            <div class="kpi-lbl">Aturan Umum</div>
          </div>
          <a href="/event" target="_blank" class="btn btn-sm btn-dark-pill px-3 py-2">
            <i class="bi bi-box-arrow-up-right me-1 text-warning"></i> Lihat di Halaman Event
          </a>
        </div>
      </div>

      <!-- BARIS 1: SUSUNAN ACARA HARI-H (RUNDOWN) -->
      <div class="row g-4 mb-4">
        <div class="col-lg-5">
          <div class="sthac-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="d-flex align-items-center gap-2">
                <span class="saiga-avatar"><i class="bi bi-clock-fill"></i></span>
                <div>
                  <h6 class="font-display fw-bold text-uppercase text-white mb-0">INPUT RUNDOWN ACARA</h6>
                  <small class="text-white-50" style="font-size:0.7rem;">Isi Kolom Waktu (Kiri) &amp; Kegiatan (Kanan)</small>
                </div>
              </div>
              <span class="badge-green-soft" id="oop-badge-mode-rnd">MODE TAMBAH</span>
            </div>

            <form onsubmit="window.sthacPanitiaApp.rundownManager.submitRundownForm(event)">
              <input type="hidden" id="oop-inp-rnd-id" value="" />
              <div class="row g-2 mb-3">
                <div class="col-4">
                  <label class="small fw-bold text-warning mb-1">WAKTU / JAM *</label>
                  <input type="text" id="oop-inp-rnd-jam" class="form-control sthac-input fw-bold" placeholder="07.00" required />
                </div>
                <div class="col-8">
                  <label class="small fw-bold text-warning mb-1">TEKS KEGIATAN ACARA *</label>
                  <input type="text" id="oop-inp-rnd-keg" class="form-control sthac-input" placeholder="Registrasi ulang peserta..." required />
                </div>
              </div>
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold">
                  <i class="bi bi-save me-1"></i> <span id="oop-btn-label-rnd">Simpan Jadwal</span>
                </button>
                <button type="button" onclick="window.sthacPanitiaApp.rundownManager.resetRundownForm()" class="btn btn-dark-pill px-3 py-2">Reset</button>
              </div>
            </form>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="sthac-card p-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
              <h6 class="font-display fw-bold text-uppercase text-white mb-0">SUSUNAN ACARA HARI-H (<span id="lbl-rundown-count">9</span>)</h6>
              <button type="button" onclick="window.sthacPanitiaApp.rundownManager.restoreDefaultRundown()" class="btn btn-sm btn-dark-pill px-3 py-1">
                <i class="bi bi-arrow-counterclockwise me-1 text-warning"></i> Muat Default (07.00 - 16.30)
              </button>
            </div>
            <div class="table-responsive">
              <table class="table sthac-table mb-0 small align-middle">
                <thead>
                  <tr>
                    <th style="width: 115px;">WAKTU</th>
                    <th>TEKS KEGIATAN ACARA</th>
                    <th class="text-end" style="width: 120px;">AKSI</th>
                  </tr>
                </thead>
                <tbody id="oop-rundown-tbody"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- BARIS 2: ATURAN UMUM PERTANDINGAN -->
      <div class="row g-4">
        <div class="col-lg-5">
          <div class="sthac-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="d-flex align-items-center gap-2">
                <span class="saiga-avatar"><i class="bi bi-shield-check"></i></span>
                <div>
                  <h6 class="font-display fw-bold text-uppercase text-white mb-0">INPUT ATURAN UMUM</h6>
                  <small class="text-white-50" style="font-size:0.7rem;">Regulasi &amp; Ketentuan Pertandingan</small>
                </div>
              </div>
              <span class="badge-green-soft" id="oop-badge-mode-prt">MODE TAMBAH</span>
            </div>

            <form onsubmit="window.sthacPanitiaApp.rundownManager.submitAturanForm(event)">
              <input type="hidden" id="oop-inp-prt-id" value="" />
              <div class="mb-3">
                <label class="small fw-bold text-warning mb-1">TEKS BUTIR ATURAN UMUM *</label>
                <textarea id="oop-inp-prt-isi" rows="4" class="form-control sthac-input" placeholder="Tulis butir aturan umum pertandingan..." required></textarea>
              </div>
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold">
                  <i class="bi bi-save me-1"></i> <span id="oop-btn-label-prt">Simpan Aturan</span>
                </button>
                <button type="button" onclick="window.sthacPanitiaApp.rundownManager.resetAturanForm()" class="btn btn-dark-pill px-3 py-2">Reset</button>
              </div>
            </form>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="sthac-card p-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
              <h6 class="font-display fw-bold text-uppercase text-white mb-0">ATURAN UMUM PERTANDINGAN (<span id="lbl-aturan-count">7</span>)</h6>
              <button type="button" onclick="window.sthacPanitiaApp.rundownManager.restoreDefaultAturan()" class="btn btn-sm btn-dark-pill px-3 py-1">
                <i class="bi bi-arrow-counterclockwise me-1 text-warning"></i> Muat 7 Aturan Default
              </button>
            </div>
            <div class="table-responsive">
              <table class="table sthac-table mb-0 small align-middle">
                <thead>
                  <tr>
                    <th style="width: 50px;">NO</th>
                    <th>ISI ATURAN UMUM PERTANDINGAN</th>
                    <th class="text-end" style="width: 105px;">AKSI</th>
                  </tr>
                </thead>
                <tbody id="oop-aturan-tbody"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== 12B. TAB SPONSOR & MITRA (6 KOTAK FOTO SPONSOR BERANDA) ==================== -->
    <div id="adm-sec-sponsor" class="admin-section" style="display:none;">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; SISTEM &amp; KONTEN &rsaquo; SPONSOR &amp; MITRA</div>
          <h2 class="font-display fw-bold text-white mb-1">Kelola 6 Kotak Foto Sponsor &amp; Mitra Beranda</h2>
          <p class="small text-white-50 mb-0">Unggah foto/logo sponsor untuk masing-masing dari 6 kotak slot yang tampil di bagian bawah halaman Beranda.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <div class="saiga-kpi-mini text-center">
            <div class="kpi-val"><%= (sponsorList || []).filter(s => s.terisi).length %> / 6</div>
            <div class="kpi-lbl">Slot Terisi</div>
          </div>
          <a href="/#sponsor-mitra" target="_blank" class="btn btn-sm btn-dark-pill px-3 py-2">
            <i class="bi bi-box-arrow-up-right me-1 text-warning"></i> Lihat di Beranda
          </a>
        </div>
      </div>

      <div class="row g-4">
        <!-- Kiri: Form Upload & Edit Slot Sponsor (1 - 6) -->
        <div class="col-lg-5">
          <div class="sthac-card p-4 h-100" id="card-form-sponsor">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="d-flex align-items-center gap-2">
                <span class="saiga-avatar"><i class="bi bi-image-fill"></i></span>
                <div>
                  <h6 class="font-display fw-bold text-uppercase text-white mb-0" id="title-form-sponsor">UNGGAH FOTO SPONSOR</h6>
                  <small class="text-white-50" style="font-size:0.7rem;">Pilih Slot 1 s/d 6 &amp; Upload Gambar</small>
                </div>
              </div>
              <span class="badge-green-soft" id="badge-slot-sponsor">SLOT #1</span>
            </div>

            <form id="form-crud-sponsor" onsubmit="submitSponsorForm(event)">
              <div class="mb-3">
                <label class="small fw-bold text-warning mb-1">PILIH NOMOR KOTAK SLOT (1 – 6) *</label>
                <select name="slotNumber" id="inp-sponsor-slot" onchange="onSelectSponsorSlot(this.value)" class="form-select sthac-input fw-bold" required>
                  <% (sponsorList || []).forEach(sp => { %>
                    <option value="<%= sp.slotNumber %>">Kotak Slot #<%= sp.slotNumber %> — <%= sp.namaSponsor %> (<%= sp.terisi ? 'Sudah Ada Foto' : 'Belum Ada Foto' %>)</option>
                  <% }) %>
                </select>
              </div>

              <div class="row g-2 mb-3">
                <div class="col-7">
                  <label class="small fw-bold text-warning mb-1">NAMA SPONSOR / MITRA *</label>
                  <input type="text" name="namaSponsor" id="inp-sponsor-nama" class="form-control sthac-input" placeholder="Contoh: Bank Syariah / Brand..." required />
                </div>
                <div class="col-5">
                  <label class="small fw-bold text-warning mb-1">KATEGORI / TIER</label>
                  <select name="kategori" id="inp-sponsor-kategori" class="form-select sthac-input">
                    <option value="Main Sponsor">Main Sponsor</option>
                    <option value="Official Partner">Official Partner</option>
                    <option value="Supporting Partner">Supporting Partner</option>
                    <option value="Media Partner">Media Partner</option>
                  </select>
                </div>
              </div>

              <div class="mb-3">
                <label class="small fw-bold text-warning mb-1">UPLOAD FILE FOTO / LOGO DARI KOMPUTER *</label>
                <input type="file" id="inp-sponsor-file" accept="image/*" onchange="previewSponsorFile(this)" class="form-control sthac-input" />
                <small class="text-white-50 d-block mt-1" style="font-size:0.7rem;">Mendukung format JPG, PNG, WEBP, atau SVG. Otomatis menyesuaikan ukuran kotak.</small>
              </div>

              <div class="mb-3">
                <label class="small fw-bold text-warning mb-1">ATAU TEMPEL URL GAMBAR</label>
                <input type="text" name="fotoUrl" id="inp-sponsor-foto" oninput="updateSponsorPreviewBox(this.value)" class="form-control sthac-input" placeholder="https://... atau hasil upload otomatis" />
              </div>

              <!-- Kotak Pratinjau Gambar Sebelum Disimpan -->
              <div class="p-3 rounded-3 mb-3 text-center" style="background:var(--bg-table-head); border:1px dashed var(--border-card-hover);">
                <div class="small text-white-50 mb-2" style="font-size:0.7rem;">PRATINJAU GAMBAR SLOT:</div>
                <div id="sponsor-preview-wrap" class="mx-auto d-flex align-items-center justify-content-center rounded-3" style="height:110px; max-width:240px; background:#FFFFFF; padding:0.5rem;">
                  <img id="img-sponsor-preview" src="" alt="Preview" style="max-height:95px; max-width:100%; object-fit:contain; display:none;" />
                  <span id="txt-sponsor-nopreview" class="small text-muted">Belum ada gambar dipilih</span>
                </div>
              </div>

              <div class="mb-3">
                <label class="small fw-bold text-warning mb-1">TAUTAN WEBSITE / INSTAGRAM (OPSIONAL)</label>
                <input type="text" name="websiteUrl" id="inp-sponsor-web" value="#" class="form-control sthac-input" placeholder="https://instagram.com/..." />
              </div>

              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold">
                  <i class="bi bi-cloud-check-fill me-1"></i> Simpan ke Kotak Slot
                </button>
                <button type="button" onclick="clearSponsorSlot()" class="btn btn-logout-pill px-3 py-2" title="Kosongkan Foto Slot Ini">
                  <i class="bi bi-trash"></i>
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Kanan: Visualisasi 6 Kotak Slot Sponsor (Klik untuk Edit Cepat) -->
        <div class="col-lg-7">
          <div class="sthac-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <h6 class="font-display fw-bold text-uppercase text-white mb-0">6 KOTAK SLOT SPONSOR BERANDA</h6>
                <small class="text-white-50">Klik tombol <strong>Pilih / Ganti Foto</strong> pada salah satu kotak di bawah untuk mengunggah foto.</small>
              </div>
              <span class="badge-gold-outline">6 Slot Aktif</span>
            </div>

            <div class="row g-3">
              <% (sponsorList || []).forEach(sp => { %>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 rounded-3 h-100 d-flex flex-column justify-content-between" style="background:var(--bg-table-head); border:1px solid var(--border-main);">
                    <div>
                      <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-warning text-dark fw-bold">SLOT #<%= sp.slotNumber %></span>
                        <span class="badge <%= sp.terisi ? 'bg-success-subtle text-success' : 'bg-secondary' %>" style="font-size:0.65rem;">
                          <%= sp.terisi ? 'Terisi' : 'Kosong' %>
                        </span>
                      </div>

                      <div class="rounded-3 mb-2 d-flex align-items-center justify-content-center overflow-hidden" style="height:105px; background:<%= sp.terisi ? '#FFFFFF' : 'rgba(15,41,30,0.08)' %>; border:1px solid var(--border-main); padding:0.5rem;">
                        <% if (sp.terisi) { %>
                          <img src="<%= sp.fotoUrl %>" alt="<%= sp.namaSponsor %>" style="max-height:90px; max-width:100%; object-fit:contain;" />
                        <% } else { %>
                          <div class="text-center text-white-50 small">
                            <i class="bi bi-image fs-4 d-block mb-1"></i>
                            <span style="font-size:0.7rem;">Belum ada foto</span>
                          </div>
                        <% } %>
                      </div>

                      <div class="fw-bold text-white text-truncate small"><%= sp.namaSponsor %></div>
                      <div class="text-white-50" style="font-size:0.68rem;"><%= sp.kategori %></div>
                    </div>

                    <div class="d-flex gap-1 mt-3 pt-2 border-top" style="border-color:var(--border-main) !important;">
                      <button type="button" onclick="onSelectSponsorSlot(<%= sp.slotNumber %>, true)" class="btn btn-sm btn-gold-pill flex-grow-1 py-1" style="font-size:0.74rem;">
                        <i class="bi bi-upload me-1"></i> <%= sp.terisi ? 'Ganti Foto' : 'Upload Foto' %>
                      </button>
                      <% if (sp.terisi) { %>
                        <button type="button" onclick="clearSponsorSlot(<%= sp.slotNumber %>)" class="btn btn-sm btn-logout-pill px-2 py-1" title="Hapus Foto">
                          <i class="bi bi-x-lg"></i>
                        </button>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>

<!-- ==================== 13. TAB SETELAN SITUS ==================== -->
    <div id="adm-sec-setelan" class="admin-section" style="display:none;">
      <div class="mb-4">
        <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; SISTEM &amp; KONTEN &rsaquo; PENGATURAN SITUS</div>
        <h2 class="font-display fw-bold text-white mb-1">Pengaturan Identitas &amp; Konfigurasi Situs</h2>
        <p class="small text-white-50 mb-0">Perbarui nama kejuaraan, headline hero, lokasi arena, nomor kontak, serta status pendaftaran publik.</p>
      </div>

      <div class="sthac-card p-4">
        <form onsubmit="submitEntityForm(event, 'setelan')">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="small fw-bold text-warning mb-1">NAMA KEJUARAAN</label>
              <input type="text" name="eventName" value="<%= setting.eventName %>" class="form-control sthac-input" required />
            </div>
            <div class="col-md-6">
              <label class="small fw-bold text-warning mb-1">HEADLINE HERO</label>
              <input type="text" name="headline" value="<%= setting.headline %>" class="form-control sthac-input" />
            </div>
            <div class="col-md-6">
              <label class="small fw-bold text-warning mb-1">LOKASI VENUE</label>
              <input type="text" name="location" value="<%= setting.location %>" class="form-control sthac-input" />
            </div>
            <div class="col-md-3">
              <label class="small fw-bold text-warning mb-1">WHATSAPP PANITIA</label>
              <input type="text" name="whatsapp" value="<%= setting.whatsapp %>" class="form-control sthac-input" />
            </div>
            <div class="col-md-3">
              <label class="small fw-bold text-warning mb-1">INSTAGRAM</label>
              <input type="text" name="instagram" value="<%= setting.instagram %>" class="form-control sthac-input" />
            </div>
            <div class="col-md-6">
              <label class="small fw-bold text-warning mb-1">STATUS PENDAFTARAN PUBLIK</label>
              <select name="registrationOpen" class="form-select sthac-input">
                <option value="true" <%= setting.registrationOpen ? 'selected' : '' %>>Dibuka (Peserta dapat mendaftar)</option>
                <option value="false" <%= !setting.registrationOpen ? 'selected' : '' %>>Ditutup</option>
              </select>
            </div>
          </div>
          <div class="mt-4">
            <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold"><i class="bi bi-check2-circle me-1"></i> Simpan Pengaturan Situs</button>
          </div>
        </form>
      </div>
    </div>

  </div><script src="/js/PanitiaDashboardApp.js"></script>
<script src="/js/PanitiaDashboardApp.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    window.sthacPanitiaApp = new PanitiaDashboardApp({
      existingRuns: <%- JSON.stringify(scoreRunList.map(r => ({ id: r.id, kelasId: r.kelasId, riderId: r.riderId, runNumber: r.runNumber, t1: r.target1, t2: r.target2, t3: r.target3, waktu: r.waktuTempuh, totalSkor: r.totalSkor }))) %>,
      sponsorSlots: <%- JSON.stringify(sponsorList || []) %>
    });
    window.sthacPanitiaApp.init();
  });
</script>
<script src="/js/sthac-image-uploader.js"></script>
