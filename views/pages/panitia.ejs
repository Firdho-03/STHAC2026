        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('stable')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">STABLE &amp; KLUB</span>
              <span class="badge-gold-outline">PARTISIPAN</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
