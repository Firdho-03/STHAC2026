<script>
  let otpPurpose = 'login';
  let activeEmailOtp = '';

  function checkAdminAuth() {
    const saved = sessionStorage.getItem('sthac_admin_session');
    if (saved) {
      const user = JSON.parse(saved);
      document.getElementById('admin-auth-gate').style.display = 'none';
      document.getElementById('admin-workspace').style.display = 'block';
      document.getElementById('lbl-admin-user').innerText = `${user.namaLengkap} (${user.peran})`;
      const lastTab = sessionStorage.getItem('sthac_active_adm_tab') || 'ringkasan';
      openAdminTab(lastTab);
    } else {
      document.getElementById('admin-auth-gate').style.display = 'block';
      document.getElementById('admin-workspace').style.display = 'none';
    }
  }

  function switchAuthTab(mode) {
    document.getElementById('form-otp-verify').style.display = 'none';
    document.getElementById('form-auth-otp').style.display = mode === 'otp' ? 'flex' : 'none';
    document.getElementById('form-auth-reg').style.display = mode === 'reg' ? 'flex' : 'none';
    document.getElementById('form-auth-pass').style.display = mode === 'pass' ? 'flex' : 'none';
    document.getElementById('tab-auth-otp').className = `btn flex-grow-1 py-2 small ${mode === 'otp' ? 'btn-gold-pill' : 'btn-dark-pill'}`;
    document.getElementById('tab-auth-reg').className = `btn flex-grow-1 py-2 small ${mode === 'reg' ? 'btn-gold-pill' : 'btn-dark-pill'}`;
    document.getElementById('tab-auth-pass').className = `btn flex-grow-1 py-2 small ${mode === 'pass' ? 'btn-gold-pill' : 'btn-dark-pill'}`;
  }

  async function handleReqLoginOtp(e) {
    e.preventDefault();
    otpPurpose = 'login';
    const email = new FormData(e.target).get('email');
    const res = await fetch('/api/panitia/login/request-otp', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email })
    });
    const out = await res.json();
    if (out.success) {
      activeEmailOtp = out.email;
      document.getElementById('form-auth-otp').style.display = 'none';
      document.getElementById('form-otp-verify').style.display = 'flex';
      document.getElementById('lbl-otp-email').innerText = out.email;
      
      document.getElementById('inp-otp-code').value = '';
    } else alert(out.error);
  }

  async function handleReqRegOtp(e) {
    e.preventDefault();
    otpPurpose = 'register';
    const res = await fetch('/api/panitia/register/request-otp', { method: 'POST', body: new FormData(e.target) });
    const out = await res.json();
    if (out.success) {
      activeEmailOtp = out.email;
      document.getElementById('form-auth-reg').style.display = 'none';
      document.getElementById('form-otp-verify').style.display = 'flex';
      document.getElementById('lbl-otp-email').innerText = out.email;
      
      document.getElementById('inp-otp-code').value = '';
    } else alert(out.error);
  }

  async function handleVerifyOtp(e) {
    e.preventDefault();
    const otpCode = document.getElementById('inp-otp-code').value;
    const url = otpPurpose === 'login' ? '/api/panitia/login/verify-otp' : '/api/panitia/register/verify-otp';
    const res = await fetch(url, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: activeEmailOtp, otpCode })
    });
    const out = await res.json();
    if (out.success) {
      sessionStorage.setItem('sthac_admin_session', JSON.stringify(out.user));
      window.location.reload();
    } else alert(out.error);
  }

  async function handlePassLogin(e) {
    e.preventDefault();
    const password = new FormData(e.target).get('password');
    const res = await fetch('/api/panitia/login/password', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password })
    });
    const out = await res.json();
    if (out.success) {
      sessionStorage.setItem('sthac_admin_session', JSON.stringify(out.user));
      window.location.reload();
    } else alert(out.error);
  }

  function logoutAdmin() {
    sessionStorage.removeItem('sthac_admin_session');
    window.location.reload();
  }

  function openAdminTab(tabName) {
    sessionStorage.setItem('sthac_active_adm_tab', tabName);
    document.querySelectorAll('.admin-section').forEach(el => el.style.display = 'none');
    const target = document.getElementById('adm-sec-' + tabName);
    if (target) target.style.display = 'block';

    // Reset semua tombol grup utama ke btn-dark-pill
    const groups = {
      ringkasan: ['ringkasan'],
      peserta: ['pendaftar', 'rider', 'pelatih', 'stable'],
      teknis: ['acara', 'lintasan', 'penilaian', 'poin'],
      sistem: ['panitia', 'unduhan', 'berita'],
      setelan: ['setelan']
    };

    Object.keys(groups).forEach(gKey => {
      const btn = document.getElementById('adm-group-' + gKey);
      if (!btn) return;
      const isActive = groups[gKey].includes(tabName);
      const isDropdown = btn.classList.contains('dropdown-toggle');
      btn.className = `btn btn-sm ${isDropdown ? 'dropdown-toggle ' : ''}py-2 px-3 ${isActive ? 'btn-gold-pill' : 'btn-dark-pill'}`;
    });

    // Tandai sub-item di dalam dropdown yang sedang aktif
    document.querySelectorAll('.adm-sub-link').forEach(link => {
      if (link.getAttribute('data-tab') === tabName) {
        link.classList.add('active-sub');
      } else {
        link.classList.remove('active-sub');
      }
    });

    // Tutup dropdown yang sedang terbuka setelah item diklik
    document.querySelectorAll('.dropdown-menu-sthac.show').forEach(menu => {
      const toggleBtn = menu.previousElementSibling;
      if (toggleBtn && window.bootstrap) {
        const inst = bootstrap.Dropdown.getInstance(toggleBtn);
        if (inst) inst.hide();
      }
    });
  }

  function filterRegistrant(status) {
    document.querySelectorAll('.reg-card-item').forEach(card => {
      card.style.display = (status === 'all' || card.getAttribute('data-status') === status) ? 'block' : 'none';
    });
  }

  function searchAdminRider() {
    const q = document.getElementById('adm-search-rider').value.toLowerCase();
    document.querySelectorAll('#adm-rider-tbody tr').forEach(tr => {
      tr.style.display = tr.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
  }

