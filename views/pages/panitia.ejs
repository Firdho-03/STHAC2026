<div class="container py-4">

  <!-- ==================== POP-UP MODAL DIALOG (ERROR OTP / KONFIRMASI / SUKSES) ==================== -->
  <div id="sthac-popup-backdrop" style="display:none; position:fixed; inset:0; background:rgba(3,19,12,0.78); backdrop-filter:blur(6px); z-index:99999; align-items:center; justify-content:center; padding:1rem;">
    <div class="sthac-card p-4 p-md-5 text-center mx-auto" style="max-width:430px; width:100%; border:2px solid var(--border-dropdown); animation:dropdownPopIn 0.22s ease forwards;">
      <div id="popup-icon-wrap" class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width:64px; height:64px; background:rgba(220,38,38,0.15); color:#EF4444; font-size:2rem;">
        <i id="popup-icon" class="bi bi-exclamation-triangle-fill"></i>
      </div>
      <h4 id="popup-title" class="font-display fw-bold text-uppercase text-white mb-2">Kode OTP Tidak Valid</h4>
      <p id="popup-message" class="small text-white-50 mb-4" style="line-height:1.6;">Kode OTP yang Anda masukkan salah atau telah kedaluwarsa.</p>
      <div class="d-flex justify-content-center gap-2">
        <button type="button" id="popup-btn-cancel" onclick="closeSthacPopup(false)" class="btn btn-dark-pill px-4 py-2 d-none">Batal</button>
        <button type="button" id="popup-btn-ok" onclick="closeSthacPopup(true)" class="btn btn-gold-pill px-5 py-2 fw-bold">Mengerti</button>
      </div>
    </div>
  </div>

  <!-- ==================== GATE LOGIN PANEL PANITIA (CLEAN & PRODUCTION READY) ==================== -->
  <div id="admin-login-gate" class="py-5">
    <div class="sthac-card p-4 p-md-5 mx-auto" style="max-width: 500px;">
      <div class="text-center mb-4">
        <img src="<%= setting.logoUrl %>" alt="STHAC Logo" style="width:64px;height:64px;object-fit:contain;" class="mb-2" />
        <h2 class="font-display fw-bold text-uppercase text-white mb-1">PANEL PANITIA · STHAC 2026</h2>
        <p class="small text-white-50 mb-0">Autentikasi resmi kepanitiaan &amp; dewan juri menggunakan Kode OTP Email.</p>
      </div>

      <div class="p-1 rounded-pill mb-4 d-flex justify-content-between gap-1" style="background: rgba(15, 41, 30, 0.14); border: 1px solid var(--border-main);">
        <button type="button" id="tab-btn-login-otp" onclick="switchAuthMode('login-otp')" class="btn btn-sm btn-gold-pill flex-fill py-2">
          <i class="bi bi-envelope-check me-1"></i> Login OTP
        </button>
        <button type="button" id="tab-btn-register-otp" onclick="switchAuthMode('register-otp')" class="btn btn-sm btn-dark-pill flex-fill py-2">
          <i class="bi bi-person-plus me-1"></i> Daftar Panitia
        </button>
        <button type="button" id="tab-btn-quick-pass" onclick="switchAuthMode('quick-pass')" class="btn btn-sm btn-dark-pill flex-fill py-2">
          <i class="bi bi-shield-lock me-1"></i> Sandi Akses
        </button>
      </div>

      <!-- FORM MASUK EMAIL OTP -->
      <div id="auth-pane-login-otp">
        <form onsubmit="handleRequestOtp(event, 'LOGIN')">
          <div class="mb-3">
            <label class="small fw-bold text-warning mb-1 d-block">ALAMAT EMAIL PANITIA / JURI *</label>
            <input type="email" id="inp-login-email" class="form-control sthac-input" placeholder="Masukkan email resmi Anda..." required />
          </div>
          <button type="submit" class="btn btn-gold-pill w-100 py-2 fw-bold">
            <i class="bi bi-send-fill me-1"></i> Kirim Kode OTP ke Email
          </button>
        </form>
      </div>

      <!-- FORM DAFTAR PANITIA BARU -->
      <div id="auth-pane-register-otp" style="display:none;">
        <form onsubmit="handleRequestOtp(event, 'REGISTER')">
          <div class="mb-3">
            <label class="small fw-bold text-warning mb-1 d-block">NAMA LENGKAP *</label>
            <input type="text" id="inp-reg-name" class="form-control sthac-input" placeholder="Nama lengkap beserta gelar" required />
          </div>
          <div class="row g-2 mb-3">
            <div class="col-md-7">
              <label class="small fw-bold text-warning mb-1 d-block">ALAMAT EMAIL *</label>
              <input type="email" id="inp-reg-email" class="form-control sthac-input" placeholder="nama@email.com" required />
            </div>
            <div class="col-md-5">
              <label class="small fw-bold text-warning mb-1 d-block">JABATAN *</label>
              <select id="inp-reg-role" class="form-select sthac-input">
                <option value="Juri Utama">Juri Utama</option>
                <option value="Scorer / Pencatat">Scorer / Pencatat</option>
                <option value="Course Designer">Course Designer</option>
                <option value="Panitia Teknis">Panitia Teknis</option>
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-gold-pill w-100 py-2 fw-bold">
            <i class="bi bi-envelope-check-fill me-1"></i> Kirim Kode Verifikasi OTP
          </button>
        </form>
      </div>

      <!-- LAYAR BERSIH VERIFIKASI 6 DIGIT OTP -->
      <div id="auth-otp-verify-box" style="display:none;">
        <div class="p-3 rounded-3 mb-3 text-center" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.35);">
          <i class="bi bi-envelope-paper-heart-fill text-success fs-4 d-block mb-1"></i>
          <div class="small text-white">Kode OTP 6 digit telah dikirimkan ke:</div>
          <div id="lbl-target-otp-email" class="fw-bold text-warning small"></div>
        </div>

        <form onsubmit="handleVerifyOtp(event)">
          <div class="mb-3">
            <label class="small fw-bold text-warning mb-2 d-block text-center">MASUKKAN 6 DIGIT KODE OTP</label>
            <input type="text" id="inp-verify-otp-code" maxlength="6" inputmode="numeric" autocomplete="one-time-code"
              class="form-control sthac-input text-center font-monospace fs-4 fw-bold"
              style="letter-spacing: 8px;" placeholder="••••••" required />
          </div>
          <button type="submit" class="btn btn-gold-pill w-100 py-2 fw-bold mb-2">
            <i class="bi bi-shield-check me-1"></i> Verifikasi &amp; Masuk Panel
          </button>
          <div class="d-flex justify-content-between align-items-center pt-2">
            <a href="#" onclick="resetOtpView(); return false;" class="small text-white-50 text-decoration-none">
              <i class="bi bi-arrow-left me-1"></i> Ganti Email
            </a>
            <a href="#" onclick="resendCurrentOtp(); return false;" class="small text-warning text-decoration-none fw-semibold">
              <i class="bi bi-arrow-clockwise me-1"></i> Kirim Ulang OTP
            </a>
          </div>
        </form>
      </div>

      <!-- SANDI AKSES PANITIA -->
      <div id="auth-pane-quick-pass" style="display:none;">
        <form onsubmit="handleQuickLogin(event)">
          <div class="mb-3">
            <label class="small fw-bold text-warning mb-1 d-block">KODE AKSES OTORISASI PANITIA *</label>
            <input type="password" id="inp-quick-password" class="form-control sthac-input" placeholder="Masukkan sandi otorisasi panitia..." required />
          </div>
          <button type="submit" class="btn btn-gold-pill w-100 py-2 fw-bold">
            <i class="bi bi-box-arrow-in-right me-1"></i> Masuk Panel Panitia
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- ==================== DASHBOARD INTERAKTIF PANEL PANITIA (PROJECT SAIGA) ==================== -->
  <div id="admin-dashboard-panel" style="display:none;">

    <!-- BARIS 1: TOP ADMIN NAVBAR -->
    <div class="admin-navbar-card px-3 py-2 mb-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <span class="badge rounded-pill px-3 py-2 fw-bold" style="background:#072619; color:#F2E0AC; font-size:0.75rem; letter-spacing:0.8px;">
            <i class="bi bi-shield-check me-1"></i> PANEL PANITIA · STHAC
          </span>
          <small class="text-white-50 d-none d-md-inline" style="font-size:0.75rem;" id="lbl-active-admin-user">Super Admin · Juri Utama</small>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center" id="admin-nav-pills">
          <button type="button" id="adm-group-ringkasan" onclick="openAdminTab('ringkasan')" class="btn btn-sm btn-gold-pill py-2 px-3">
            <i class="bi bi-speedometer2 me-1"></i> Ringkasan
          </button>

          <div class="dropdown">
            <button type="button" id="adm-group-peserta" class="btn btn-sm btn-dark-pill dropdown-toggle py-2 px-3" data-bs-toggle="dropdown">
              <i class="bi bi-people-fill me-1"></i> Peserta &amp; Klub
            </button>
            <ul class="dropdown-menu dropdown-menu-sthac">
              <li><a class="dropdown-item adm-sub-link" data-tab="pendaftar" href="#" onclick="openAdminTab('pendaftar'); return false;"><i class="bi bi-person-check-fill me-2 text-warning"></i> Pendaftar (<%= stats.menungguAcc %> Pending)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="rider" href="#" onclick="openAdminTab('rider'); return false;"><i class="bi bi-person-badge-fill me-2 text-warning"></i> Data Rider (<%= stats.riderAktif %>)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="pelatih" href="#" onclick="openAdminTab('pelatih'); return false;"><i class="bi bi-person-workspace me-2 text-warning"></i> Data Pelatih (<%= stats.pelatih %>)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="stable" href="#" onclick="openAdminTab('stable'); return false;"><i class="bi bi-shield-shaded me-2 text-warning"></i> Data Stable (<%= stats.stable %>)</a></li>
            </ul>
          </div>

          <div class="dropdown">
            <button type="button" id="adm-group-teknis" class="btn btn-sm btn-dark-pill dropdown-toggle py-2 px-3" data-bs-toggle="dropdown">
              <i class="bi bi-trophy-fill me-1"></i> Teknis &amp; Penilaian
            </button>
            <ul class="dropdown-menu dropdown-menu-sthac">
              <li><a class="dropdown-item adm-sub-link" data-tab="acara" href="#" onclick="openAdminTab('acara'); return false;"><i class="bi bi-calendar-range-fill me-2 text-warning"></i> Seri &amp; Kelas (<%= stats.totalKelas %>)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="lintasan" href="#" onclick="openAdminTab('lintasan'); return false;"><i class="bi bi-signpost-split-fill me-2 text-warning"></i> Master Lintasan (<%= stats.totalLintasan %>)</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="penilaian" href="#" onclick="openAdminTab('penilaian'); return false;"><i class="bi bi-stopwatch-fill me-2 text-danger"></i> Input Penilaian Run</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="poin" href="#" onclick="openAdminTab('poin'); return false;"><i class="bi bi-award-fill me-2 text-warning"></i> Poin &amp; Juara Umum</a></li>
            </ul>
          </div>

          <div class="dropdown">
            <button type="button" id="adm-group-sistem" class="btn btn-sm btn-dark-pill dropdown-toggle py-2 px-3" data-bs-toggle="dropdown">
              <i class="bi bi-sliders me-1"></i> Sistem &amp; Konten
            </button>
            <ul class="dropdown-menu dropdown-menu-sthac">
              <li><a class="dropdown-item adm-sub-link" data-tab="panitia" href="#" onclick="openAdminTab('panitia'); return false;"><i class="bi bi-person-vcard-fill me-2 text-warning"></i> Panitia &amp; Juri (<%= stats.panitia %>)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="unduhan" href="#" onclick="openAdminTab('unduhan'); return false;"><i class="bi bi-file-earmark-arrow-down-fill me-2 text-warning"></i> Unduhan Dokumen (<%= stats.dokumen %>)</a></li>
              <li><a class="dropdown-item adm-sub-link" data-tab="berita" href="#" onclick="openAdminTab('berita'); return false;"><i class="bi bi-newspaper me-2 text-warning"></i> Berita &amp; Warta (<%= stats.berita %>)</a></li>
            </ul>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2 ms-auto ms-xl-0 ps-xl-3 border-start border-secondary border-opacity-25">
          <button type="button" id="adm-group-setelan" onclick="openAdminTab('setelan')" class="btn btn-sm btn-dark-pill py-2 px-3">
            <i class="bi bi-gear-fill text-warning me-1"></i> Setelan
          </button>
          <button type="button" onclick="logoutAdmin()" class="btn btn-sm btn-logout-pill py-2 px-3">
            <i class="bi bi-box-arrow-right me-1"></i> Keluar
          </button>
        </div>
      </div>
    </div>

    <!-- ==================== 1. TAB RINGKASAN (PUSAT KENDALI KEJUARAAN) ==================== -->
    <div id="adm-sec-ringkasan" class="admin-section">
      <div class="p-3 rounded-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span><i class="bi bi-circle-fill text-success me-2" style="font-size:0.55rem;"></i> Selamat datang, <strong id="lbl-welcome-admin">Panitia STHAC (Super Admin)</strong>.</span>
        <span class="small"><i class="bi bi-calendar3 me-1"></i> Seri 1: Sabtu, 14 November 2026 · Pendaftaran: <strong><%= setting.registrationOpen ? 'Dibuka' : 'Ditutup' %></strong></span>
      </div>

      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; RINGKASAN EKSEKUTIF</div>
          <h2 class="font-display fw-bold text-white mb-1">Pusat Kendali Kejuaraan</h2>
          <p class="small text-white-50 mb-0">Kelola pendaftaran, peserta, kelas, dan hasil penilaian kejuaraan South Tangerang Horseback Archery Cup.</p>
        </div>
        <span class="badge-green-soft px-3 py-2"><i class="bi bi-check2-circle me-1"></i> Sistem Live Terkoneksi</span>
      </div>

      <!-- 8 KARTU STATISTIK GAYA SAIGA (GRID 4x2 DENGAN IKON & BADGE) -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('pendaftar')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">PENDAFTAR MENUNGGU ACC</span>
              <span class="badge-amber-soft">MENUNGGU</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <div class="stat-num"><%= stats.menungguAcc %></div>
                <small class="text-white-50" style="font-size:0.72rem;">Perlu verifikasi panitia</small>
              </div>
              <span class="stat-icon"><i class="bi bi-person-exclamation"></i></span>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('pendaftar')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">PENDAFTAR DITERIMA</span>
              <span class="badge-green-soft">TERVERIFIKASI</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <div class="stat-num"><%= stats.pendaftarDiterima %></div>
                <small class="text-white-50" style="font-size:0.72rem;">Terdaftar resmi di seri</small>
              </div>
              <span class="stat-icon"><i class="bi bi-person-check-fill"></i></span>
            </div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="saiga-stat-box" onclick="openAdminTab('rider')">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">RIDER AKTIF</span>
              <span class="badge-green-soft">AKTIF</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <div class="stat-num"><%= stats.riderAktif %></div>
                <small class="text-white-50" style="font-size:0.72rem;">Atlet siap bertanding</small>
              </div>
              <span class="stat-icon"><i class="bi bi-person-badge-fill"></i></span>
