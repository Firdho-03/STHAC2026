                <label class="small fw-bold text-warning mb-1">NAMA LENGKAP PETUGAS *</label>
                <input type="text" name="namaLengkap" id="inp-panitia-nama" class="form-control sthac-input" placeholder="Nama lengkap & gelar" required />
