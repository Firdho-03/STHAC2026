                </div>
              </div>
              <div class="row g-2 mb-2">
                <div class="col-7">
                  <label class="small fw-bold text-warning mb-1">ZONA NILAI TARGET</label>
                  <input type="text" name="nilaiZonaTarget" id="inp-lintasan-zona" value="5 / 4 / 3 / 2 / 1" class="form-control sthac-input" />
                </div>
                <div class="col-5">
                  <label class="small fw-bold text-warning mb-1">BONUS SAPU BERSIH</label>
                  <input type="number" name="bonusSapuBersih" id="inp-lintasan-bonus" value="0" class="form-control sthac-input" />
                </div>
              </div>
              <div class="mb-3">
                <label class="small fw-bold text-warning mb-1">CATATAN / ATURAN OVERTIME</label>
                <input type="text" name="aturanOvertime" id="inp-lintasan-aturan" value="Skor minimum 0" class="form-control sthac-input" />
              </div>
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold"><i class="bi bi-save me-1"></i> Simpan Lintasan</button>
                <button type="button" onclick="resetEntityForm('form-crud-lintasan', 'inp-lintasan-id', 'title-form-lintasan', 'KONFIGURASI PARAMETER LINTASAN')" class="btn btn-dark-pill px-3 py-2">Reset</button>
              </div>
            </form>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="sthac-card p-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
              <h6 class="font-display fw-bold text-uppercase text-white mb-0"><%= lintasanList.length %> DAFTAR MASTER LINTASAN RESMI</h6>
              <input type="text" oninput="filterTableRows('table-dir-lintasan', this.value)" class="form-control form-control-sm sthac-input" style="max-width:220px;" placeholder="Cari lintasan..." />
            </div>

            <div class="table-responsive">
              <table class="table sthac-table mb-0 small" id="table-dir-lintasan">
                <thead>
                  <tr>
                    <th>KODE</th>
                    <th>NAMA LINTASAN</th>
                    <th>SISTEM</th>
                    <th>ZONA</th>
                    <th>PAR</th>
                    <th class="text-end">AKSI</th>
                  </tr>
                </thead>
                <tbody>
                  <% lintasanList.forEach(l => { %>
                    <tr>
                      <td class="font-monospace fw-bold text-warning"><%= l.kodeLintasan %></td>
                      <td>
                        <div class="fw-bold text-white"><%= l.namaLintasan %></div>
                        <small class="text-white-50" style="font-size:0.68rem;"><%= l.panjangMeter %>m · <%= l.jumlahTarget %> Target</small>
                      </td>
                      <td><span class="badge <%= l.sistem.includes('IHAA') ? 'bg-secondary' : 'bg-success' %>"><%= l.sistem.includes('IHAA') ? 'IHAA' : 'PORDASI' %></span></td>
                      <td class="font-monospace"><%= l.nilaiZonaTarget %></td>
                      <td><%= l.parTime > 0 ? l.parTime + 's' : '-' %></td>
                      <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-dark-pill px-2 py-1 me-1"
                          onclick='fillLintasanEdit(<%- JSON.stringify({ id: l.id, namaLintasan: l.namaLintasan, sistem: l.sistem, panjangMeter: l.panjangMeter, jumlahTarget: l.jumlahTarget, parTime: l.parTime, nilaiZonaTarget: l.nilaiZonaTarget, bonusSapuBersih: l.bonusSapuBersih, aturanOvertime: l.aturanOvertime }) %>)'>
                          <i class="bi bi-pencil"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-logout-pill px-2 py-1" onclick="deleteEntity('lintasan', <%= l.id %>, '<%= l.namaLintasan %>')">
                          <i class="bi bi-trash"></i>
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== 8. TAB PENILAIAN RUN & SCORING ARENA (SESUAI SCREENSHOT 4 KANAN) ==================== -->
    <div id="adm-sec-penilaian" class="admin-section" style="display:none;">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; TEKNIS &amp; PENILAIAN &rsaquo; SCORING ARENA</div>
          <h2 class="font-display fw-bold text-white mb-1">Input Penilaian Run &amp; Scoring Arena</h2>
          <p class="small text-white-50 mb-0">Pilih kelas aktif, masukkan nilai perkenaan target panah dan waktu tempuh rider per run. Skor dikalkulasi otomatis &amp; disiarkan langsung.</p>
        </div>
        <div class="d-flex gap-2">
          <span class="saiga-filter-chip active">SERI 1</span>
          <span class="saiga-filter-chip">SERI 2</span>
          <span class="saiga-filter-chip">SERI 3</span>
        </div>
      </div>

      <!-- Kartu Kelas Aktif -->
      <div class="row g-3 mb-4">
        <% kelasList.forEach(k => { %>
          <div class="col-md-6">
            <div class="sthac-card p-4 h-100 d-flex flex-column justify-content-between">
              <div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="small fw-bold text-uppercase text-white-50" style="font-size:0.68rem;">KATEGORI KEJUARAAN</span>
                  <span class="badge-green-soft"><%= k.kategori %></span>
                </div>
                <h4 class="font-display fw-bold text-uppercase text-white mb-3"><%= k.namaKelas %> · <%= k.kategori %></h4>
                <div class="row g-2 mb-3">
                  <div class="col-4">
                    <div class="p-2 rounded-3" style="background:var(--bg-table-head);">
                      <small class="text-white-50 d-block" style="font-size:0.65rem;">LINTASAN</small>
                      <strong class="small text-white"><%= k.namaLintasan %></strong>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="p-2 rounded-3" style="background:var(--bg-table-head);">
                      <small class="text-white-50 d-block" style="font-size:0.65rem;">PESERTA</small>
                      <strong class="small text-white"><%= (scoreboardByKelas[k.id] || []).length %> Rider</strong>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="p-2 rounded-3" style="background:var(--bg-table-head);">
                      <small class="text-white-50 d-block" style="font-size:0.65rem;">JUMLAH RUN</small>
                      <strong class="small text-white"><%= k.jumlahRun %> Run Dinilai</strong>
                    </div>
                  </div>
                </div>
              </div>
              <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color:var(--border-main) !important;">
                <span class="small text-success fw-semibold"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i> Siap Dinilai</span>
                <button type="button" onclick="pilihKelasUntukInput(<%= k.id %>, <%= k.jumlahRun %>)" class="btn btn-gold-pill btn-sm px-4 py-2">
                  Masukkan hasil &rarr;
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- KALKULATOR LIVE INPUT HASIL RUN PESERTA -->
      <div class="sthac-card p-4 mb-4" id="card-form-penilaian">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
          <div class="d-flex align-items-center gap-2">
            <span class="saiga-avatar"><i class="bi bi-stopwatch-fill"></i></span>
            <div>
              <h5 class="font-display fw-bold text-uppercase text-white mb-0">INPUT HASIL RUN PESERTA (LIVE BROADCAST)</h5>
              <small class="text-white-50">Kalkulasi otomatis poin target, waktu par time, dan sapu bersih</small>
            </div>
          </div>
          <span class="badge-gold-outline">Zona Nilai: 5 / 4 / 3 / 2 / 1 (0 = Meleset)</span>
        </div>

        <form id="form-input-score-run" onsubmit="submitNilaiRunPanitia(event)">
          <div class="row g-3 mb-3">
            <div class="col-md-5">
              <label class="small fw-bold text-warning mb-1">PILIH KELAS</label>
              <select id="inp-score-kelas" name="kelasId" onchange="syncExistingRunToForm()" class="form-select sthac-input" required>
                <% kelasList.forEach(k => { %>
                  <option value="<%= k.id %>" data-maxrun="<%= k.jumlahRun %>" data-partime="<%= k.lintasan ? k.lintasan.parTime : 0 %>" data-bonus="<%= k.lintasan ? k.lintasan.bonusSapuBersih : 0 %>">
                    <%= k.namaKelas %> · <%= k.kategori %> (<%= k.namaLintasan %>)
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-5">
              <label class="small fw-bold text-warning mb-1">PILIH RIDER</label>
              <select id="inp-score-rider" name="riderId" onchange="syncExistingRunToForm()" class="form-select sthac-input" required>
                <% riderList.forEach(r => { %>
                  <option value="<%= r.id %>"><%= r.kodeRider %> — <%= r.namaLengkap %> (<%= r.asalStable %>)</option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-2">
              <label class="small fw-bold text-warning mb-1">RUN KE-</label>
              <div class="input-group">
                <button type="button" onclick="stepRunNumber(-1)" class="btn btn-dark-pill px-2">-</button>
                <input type="number" id="inp-score-run" name="runNumber" value="1" min="1" max="10" oninput="syncExistingRunToForm()" class="form-control sthac-input text-center" required />
                <button type="button" onclick="stepRunNumber(1)" class="btn btn-dark-pill px-2">+</button>
              </div>
            </div>
          </div>

          <div class="p-3 rounded-3 mb-3" style="background:var(--bg-table-head); border:1px solid var(--border-main);">
            <div class="small fw-bold text-uppercase text-white-50 mb-2"><i class="bi bi-bullseye text-warning me-1"></i> INPUT PERKENAAN ZONA SASARAN &amp; CATATAN WAKTU</div>
            <div class="row g-3 align-items-end">
              <div class="col-4 col-md-3">
                <label class="small fw-bold text-warning mb-1">TARGET 1</label>
                <input type="number" id="inp-score-t1" name="t1" value="5" min="0" max="20" oninput="recalcLiveScorePreview()" class="form-control sthac-input text-center fs-5 fw-bold" required />
              </div>
              <div class="col-4 col-md-3">
                <label class="small fw-bold text-warning mb-1">TARGET 2</label>
                <input type="number" id="inp-score-t2" name="t2" value="5" min="0" max="20" oninput="recalcLiveScorePreview()" class="form-control sthac-input text-center fs-5 fw-bold" required />
              </div>
              <div class="col-4 col-md-3">
                <label class="small fw-bold text-warning mb-1">TARGET 3</label>
                <input type="number" id="inp-score-t3" name="t3" value="5" min="0" max="20" oninput="recalcLiveScorePreview()" class="form-control sthac-input text-center fs-5 fw-bold" required />
              </div>
              <div class="col-12 col-md-3">
                <label class="small fw-bold text-warning mb-1">WAKTU TEMPUH (DETIK)</label>
                <input type="number" id="inp-score-waktu" name="waktuTempuh" value="11.5" min="0" step="0.01" oninput="recalcLiveScorePreview()" class="form-control sthac-input text-center fs-5 fw-bold" />
              </div>
            </div>
          </div>

          <!-- BAR PRATINJAU KALKULASI REAL-TIME & TOMBOL SIMPAN -->
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex flex-wrap gap-2">
              <span class="saiga-filter-chip">Total Poin Target: <strong id="prev-poin-target" class="text-warning">15.0 Pts</strong></span>
              <span class="saiga-filter-chip">Poin Waktu: <strong id="prev-poin-waktu" class="text-warning">0.0 Pts</strong></span>
              <span class="badge-green-soft px-3 py-2">Estimasi Skor Run: <strong id="prev-total-skor">15.00 Pts</strong></span>
            </div>
            <button type="submit" class="btn btn-gold-pill flex-grow-1 py-2 fw-bold">
              <i class="bi bi-check2-circle me-1"></i> Simpan Hasil Run &amp; Perbarui Papan Skor Publik
            </button>
          </div>
        </form>
      </div>

      <!-- Tabel Entri Penilaian Run Terakhir -->
      <div class="sthac-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="font-display fw-bold text-uppercase text-white mb-0">Entri Penilaian Run Terakhir di Arena (<%= scoreRunList.length %> Run)</h6>
          <a href="/skor" target="_blank" class="small text-warning text-decoration-none fw-bold">Buka Layar Penuh &nearr;</a>
        </div>
        <div class="table-responsive">
          <table class="table sthac-table mb-0 small">
            <thead>
              <tr>
                <th>RIDER &amp; STABLE</th>
                <th>KELAS</th>
                <th class="text-center">RUN</th>
                <th class="text-center">T1 · T2 · T3</th>
                <th class="text-center">WAKTU</th>
                <th class="text-end">TOTAL SKOR</th>
                <th class="text-end">AKSI</th>
              </tr>
            </thead>
            <tbody>
              <% if (scoreRunList.length === 0) { %>
                <tr><td colspan="7" class="text-center py-4 text-white-50">Belum ada nilai run yang diinput.</td></tr>
              <% } %>
              <% scoreRunList.forEach(sr => { %>
                <tr>
                  <td>
                    <div class="fw-bold text-white"><%= sr.rider ? sr.rider.namaLengkap : ('Rider #' + sr.riderId) %></div>
                    <small class="text-white-50" style="font-size:0.68rem;"><%= sr.rider ? (sr.rider.kodeRider + ' · ' + sr.rider.asalStable) : '' %></small>
                  </td>
                  <td><%= sr.kelas ? sr.kelas.namaKelas : ('Kelas #' + sr.kelasId) %></td>
                  <td class="text-center"><span class="badge bg-warning text-dark">#<%= sr.runNumber %></span></td>
                  <td class="text-center font-monospace fw-bold"><%= sr.target1 ?? 0 %> · <%= sr.target2 ?? 0 %> · <%= sr.target3 ?? 0 %></td>
                  <td class="text-center"><%= sr.waktuTempuh ?? 0 %>s</td>
                  <td class="text-end"><span class="badge-green-soft fs-6"><%= sr.totalSkor ?? 0 %> Pts</span></td>
                  <td class="text-end text-nowrap">
                    <button type="button" class="btn btn-sm btn-dark-pill px-2 py-1 me-1"
                      onclick="isiFormEditSkor(<%= sr.kelasId %>, <%= sr.riderId %>, <%= sr.runNumber %>, <%= sr.target1 ?? 0 %>, <%= sr.target2 ?? 0 %>, <%= sr.target3 ?? 0 %>, <%= sr.waktuTempuh ?? 0 %>)">
                      <i class="bi bi-pencil"></i> Edit
                    </button>
                    <button type="button" class="btn btn-sm btn-logout-pill px-2 py-1" onclick="hapusNilaiRunPanitia(<%= sr.id %>)">
                      <i class="bi bi-trash"></i>
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- SKEMA VISUAL LINTASAN & MINI CHEAT-SHEET (SESUAI SCREENSHOT 4 KANAN BAWAH) -->
      <div class="row g-4">
        <div class="col-lg-8">
          <div class="sthac-card p-4 h-100">
            <h6 class="font-display fw-bold text-uppercase text-white mb-2"><i class="bi bi-bezier2 text-warning me-2"></i>SKEMA VISUAL LINTASAN (90M–150M IHAA / PORDASI)</h6>
            <p class="small text-white-50 mb-3">Setiap perkenaan anak panah pada sasaran dihitung beserta selisih waktu tempuh dari sensor garis Start ke Finish.</p>
            <div class="saiga-track-diagram">
              <div class="d-flex justify-content-between small fw-bold text-white mb-1">
                <span class="text-success"><i class="bi bi-flag-fill me-1"></i> GARIS START (0m)</span>
                <span class="text-danger"><i class="bi bi-flag-fill me-1"></i> GARIS FINISH (90m)</span>
              </div>
              <div class="saiga-track-line d-flex justify-content-around align-items-center">
                <span class="saiga-track-node" title="Target 1 (Tembakan Depan)">T1</span>
                <span class="saiga-track-node" title="Target 2 (Tembakan Samping)">T2</span>
                <span class="saiga-track-node" title="Target 3 (Tembakan Belakang / Parthian)">T3</span>
              </div>
              <div class="d-flex justify-content-around small text-white-50 text-center mt-2" style="font-size:0.72rem;">
                <span>Target 1 (Depan / 15m)</span>
                <span>Target 2 (Samping / 45m)</span>
                <span>Target 3 (Parthian / 75m)</span>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="sthac-card p-4 h-100">
            <span class="badge-amber-soft mb-2">MINI CHEAT-SHEET</span>
            <h6 class="font-display fw-bold text-uppercase text-white mb-2">Prosedur Penilaian Resmi</h6>
            <ul class="small text-white-50 vstack gap-2 mb-0 ps-3">
              <li><strong class="text-white">DNF / Overtime:</strong> Jika kuda keluar jalur atau melebihi batas waktu maksimum, poin waktu = 0.</li>
              <li><strong class="text-white">Sapu Bersih:</strong> Bonus tambahan diberikan otomatis bila T1, T2, dan T3 seluruhnya kena (&gt; 0).</li>
              <li><strong class="text-white">Koreksi Juri:</strong> Klik tombol <em>Edit</em> pada tabel riwayat untuk memperbarui nilai run.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== 9. TAB POIN & JUARA UMUM (SESUAI SCREENSHOT 3 KIRI) ==================== -->
    <div id="adm-sec-poin" class="admin-section" style="display:none;">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; TEKNIS &amp; PENILAIAN &rsaquo; POIN &amp; JUARA UMUM</div>
          <h2 class="font-display fw-bold text-white mb-1"><i class="bi bi-trophy-fill text-warning me-2"></i>PRATINJAU JUARA UMUM</h2>
          <p class="small text-white-50 mb-0">Akumulasi poin seri menuju piala bergilir Juara Umum STHAC 2026.</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/juara" target="_blank" class="btn btn-sm btn-dark-pill px-3 py-2"><i class="bi bi-printer me-1"></i> Lihat Klasemen Publik</a>
          <button type="button" onclick="window.location.reload()" class="btn btn-sm btn-forest-pill px-3 py-2"><i class="bi bi-arrow-repeat me-1 text-warning"></i> Kalkulasi Ulang</button>
        </div>
      </div>

      <!-- 3 Kartu Ringkasan Poin -->
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <div class="sthac-card p-4">
            <small class="text-white-50 fw-bold text-uppercase" style="font-size:0.68rem;">CAKUPAN SERI AKTIF</small>
            <div class="font-display fw-bold fs-3 text-white mt-1"><%= kelasList.length %> Kelas Dinilai</div>
            <small class="text-success"><i class="bi bi-check-circle-fill me-1"></i> 100% Terkalkulasi Otomatis</small>
          </div>
        </div>
        <div class="col-md-4">
          <div class="sthac-card p-4">
            <small class="text-white-50 fw-bold text-uppercase" style="font-size:0.68rem;">POIN TERTINGGI SEMENTARA</small>
            <div class="font-display fw-bold fs-3 text-gold mt-1"><%= standings[0] ? standings[0].totalPoints : 0 %> pts</div>
            <small class="text-white-50"><%= standings[0] ? (standings[0].namaLengkap + ' (' + standings[0].asalStable + ')') : '-' %></small>
          </div>
        </div>
        <div class="col-md-4">
          <div class="sthac-card p-4">
            <small class="text-white-50 fw-bold text-uppercase" style="font-size:0.68rem;">SISTEM POIN KEJUARAAN</small>
            <div class="font-display fw-bold fs-3 text-white mt-1">IHAA &amp; Pordasi</div>
            <small class="text-white-50">Tie-breaker: P1 Count &rarr; Skor Lintasan</small>
          </div>
        </div>
      </div>

      <div class="sthac-card p-4 mb-4">
        <h6 class="font-display fw-bold text-uppercase text-white mb-3">Klasemen Juara Umum Sementara</h6>
        <div class="table-responsive">
          <table class="table sthac-table mb-0 small">
            <thead>
              <tr>
                <th>PERINGKAT</th>
                <th>KODE</th>
                <th>RIDER</th>
                <th>STABLE / KLUB</th>
                <th class="text-center">JUARA 1 (P1)</th>
                <th class="text-center">SKOR LINTASAN</th>
                <th class="text-end">TOTAL POIN</th>
              </tr>
            </thead>
            <tbody>
              <% standings.forEach((st, i) => { %>
                <tr>
                  <td><span class="badge <%= i < 3 ? 'bg-warning text-dark' : 'bg-secondary' %> px-3 py-1">Peringkat <%= i + 1 %></span></td>
                  <td class="font-monospace fw-bold text-warning"><%= st.kodeRider %></td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <span class="saiga-avatar" style="width:28px;height:28px;font-size:0.7rem;"><%= (st.namaLengkap || 'R').substring(0,2).toUpperCase() %></span>
                      <span class="fw-bold text-white"><%= st.namaLengkap %></span>
                    </div>
                  </td>
                  <td><%= st.asalStable %></td>
                  <td class="text-center"><%= st.p1Count %>x</td>
                  <td class="text-center"><%= st.totalSkorLintasan %></td>
                  <td class="text-end font-display fw-bold fs-5 text-gold"><%= st.totalPoints %> <small class="fs-6">pts</small></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ==================== 10. TAB PANITIA & JURI (SPLIT-SCREEN SESUAI SCREENSHOT 3 TENGAH) ==================== -->
    <div id="adm-sec-panitia" class="admin-section" style="display:none;">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
          <div class="saiga-breadcrumb mb-1">PANEL PANITIA &rsaquo; SISTEM &amp; KONTEN &rsaquo; PANITIA &amp; JURI</div>
          <h2 class="font-display fw-bold text-white mb-1">Kelola Dewan Juri &amp; Panitia Pelaksana</h2>
          <p class="small text-white-50 mb-0">Registrasi dewan juri berlisensi, scorer pencatat waktu, dan petugas teknis yang berhak login via OTP Email.</p>
        </div>
        <div class="d-flex gap-2">
          <div class="saiga-kpi-mini text-center"><div class="kpi-val"><%= panitiaList.length %></div><div class="kpi-lbl">Personel</div></div>
          <div class="saiga-kpi-mini text-center"><div class="kpi-val">100%</div><div class="kpi-lbl">Akses OTP</div></div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-5">
          <div class="sthac-card p-4 h-100" id="card-form-panitia">
