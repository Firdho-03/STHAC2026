<div class="saiga-page-header-dark mb-2"><div class="container"><span class="sthac-eyebrow">OFFICIAL STHAC 2026</span></div></div>
<div class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
    <div>
      <span class="badge-gold-outline mb-2"><i class="bi bi-broadcast text-danger me-1"></i> LIVE SCOREBOARD</span>
      <h1 class="font-display fw-bold text-uppercase text-white mb-1">Papan Skor Pertandingan</h1>
      <p class="text-white-50 mb-0">Filter berdasarkan seri kejuaraan. Skor diperbarui secara langsung saat juri menyimpan hasil run.</p>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
      <% seriList.forEach(s => { %>
        <a href="/skor?seri=<%= s.id %>" class="btn <%= selectedSeriId === s.id ? 'btn-gold-pill' : 'btn-dark-pill' %> btn-sm px-3">
          SERI <%= s.nomorSeri %>
        </a>
      <% }) %>
      <button id="btn-autoreload" onclick="toggleAutoReload()" class="btn btn-dark-pill btn-sm px-3">
        <i class="bi bi-arrow-repeat me-1 text-warning"></i> Auto-Reload (60s): <span id="ar-state">AKTIF</span>
      </button>
    </div>
  </div>

  <% if (classScoreboards.length === 0) { %>
    <div class="sthac-card p-5 text-center text-white-50">
      Belum ada kelas yang dipertandingkan pada Seri ini.
    </div>
  <% } else { %>
    <% classScoreboards.forEach(board => { %>
      <div class="sthac-card p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3 border-bottom border-secondary border-opacity-25">
          <div>
            <span class="badge bg-warning text-dark fw-bold me-2"><%= board.kelas.kategori %></span>
            <span class="text-white-50 small"><i class="bi bi-signpost-split me-1"></i><%= board.kelas.namaLintasan %> · <%= board.kelas.jumlahRun %> runs</span>
            <h3 class="font-display fw-bold text-uppercase text-white mt-1 mb-0">
              Class: <%= board.kelas.namaKelas %> · <%= board.kelas.kategori %>
            </h3>
          </div>
        </div>

        <!-- Podium Top 3 Display -->
        <div class="row g-3 mb-4">
          <% board.standings.slice(0, 3).forEach((p, idx) => { %>
            <div class="col-md-4">
              <div class="p-3 rounded-4 h-100 d-flex justify-content-between align-items-center" style="background:rgba(217,180,92,0.07);border:1px solid rgba(217,180,92,0.25);">
                <div>
                  <small class="text-warning fw-bold d-block">PODIUM #<%= p.rank %></small>
                  <a href="/profile?id=<%= p.riderId %>" class="fw-bold text-white text-decoration-none"><%= p.namaLengkap %></a>
                  <small class="d-block text-white-50"><%= p.asalStable %> · Bib #<%= p.noBib %></small>
                </div>
                <div class="text-end">
                  <span class="font-display fw-bold fs-4 text-gold"><%= p.total %></span>
                  <small class="d-block text-white-50">Total</small>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- Tabel Lengkap Skor Kelas -->
        <div class="table-responsive">
          <table class="table table-dark sthac-table mb-0">
            <thead>
              <tr>
                <th>RANK</th>
                <th>BIB</th>
                <th>RIDER</th>
                <th>STABLE</th>
                <th class="text-center">RUNS</th>
                <th class="text-center">PTS</th>
                <th class="text-center">BEST</th>
                <th class="text-end">TOTAL</th>
              </tr>
            </thead>
            <tbody>
              <% board.standings.forEach(row => { %>
                <tr>
                  <td class="fw-bold text-warning">#<%= row.rank %></td>
                  <td><span class="badge bg-secondary bg-opacity-25 text-white"><%= row.noBib %></span></td>
                  <td>
                    <a href="/profile?id=<%= row.riderId %>" class="fw-bold text-white text-decoration-none hover-gold">
                      <%= row.namaLengkap %>
                    </a>
                    <small class="text-white-50 ms-1">(<%= row.kodeRider %>)</small>
                  </td>
                  <td class="text-white-50"><%= row.asalStable %></td>
                  <td class="text-center"><%= row.runsLabel %></td>
                  <td class="text-center"><%= row.targetPoints %></td>
                  <td class="text-center"><%= row.bestRun %></td>
                  <td class="text-end font-display fw-bold fs-5 text-gold"><%= row.total %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<script>
  let arTimer = setInterval(() => window.location.reload(), 60000);
  let arEnabled = true;
  function toggleAutoReload() {
    arEnabled = !arEnabled;
    document.getElementById('ar-state').innerText = arEnabled ? 'AKTIF' : 'MATI';
    if (arEnabled) arTimer = setInterval(() => window.location.reload(), 60000);
    else clearInterval(arTimer);
  }
</script>