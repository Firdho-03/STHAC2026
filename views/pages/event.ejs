<div class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
    <div>
      <span class="badge-gold-outline mb-2">INFORMASI PELAKSANAAN</span>
      <h1 class="font-display fw-bold text-uppercase text-forest mb-1">Event &amp; Jadwal Seri 1</h1>
      <p class="text-secondary mb-0">Sabtu, 14 November 2026 · <%= setting.location %></p>
    </div>
    <a href="/pendaftaran" class="btn btn-gold-pill px-4 py-2">Daftar Seri 1 &rarr;</a>
  </div>

  <!-- Banner Fotografi Lebar Sesuai Frame 2 Figma -->
  <div class="saiga-photo-banner p-4 p-md-5 mb-5 d-flex flex-column justify-content-end">
    <span class="sthac-eyebrow mb-2" style="width:fit-content;">SERI PEMBUKA 2026</span>
    <h2 class="font-display fw-bold text-uppercase text-white mb-1">Saiga Stable Equestrian Arena</h2>
    <p class="mb-0 text-white-50" style="max-width:620px;">
      Pertandingan dilaksanakan sesuai regulasi keselamatan kuda &amp; rider dengan juri berlisensi Pordasi Berkuda Memanah dan standar lintasan IHAA.
    </p>
  </div>

  <div class="sthac-card p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
      <div>
        <h4 class="font-display fw-bold text-uppercase text-forest mb-0">Kelas Pertandingan — Seri 1</h4>
        <small class="text-secondary">Penilaian mengacu pada sistem IHAA &amp; Pordasi Berkuda Memanah.</small>
      </div>
      <a href="/pendaftaran" class="btn btn-gold-pill btn-sm px-3">Daftar ke Kelas &rarr;</a>
    </div>

    <div class="table-responsive">
      <div class="table-responsive">
        <table class="table sthac-table align-middle mb-0">
          <thead>
            <tr>
              <th class="ps-4">#</th>
              <th>NAMA KELAS</th>
              <th>KATEGORI</th>
              <th>ARENA</th>
              <th>JUMLAH RUN</th>
              <th>KUOTA</th>
              <th class="pe-4">STATUS</th>
            </tr>
          </thead>
          <tbody>
            <% const klsData = (typeof kelasList !== 'undefined' && Array.isArray(kelasList) && kelasList.length > 0) ? kelasList : [
              { id: 1, namaKelas: 'Beginner ( Walk ) · U14', kategori: 'U14', arena: 'Arena Walk-Trot', jumlahRun: 6, kuota: '1/20', status: 'Aktif' },
              { id: 2, namaKelas: 'Beginner ( Trot ) · Terbuka', kategori: 'Terbuka', arena: 'Arena Walk-Trot', jumlahRun: 3, kuota: '2/30', status: 'Aktif' }
            ]; %>
            <% klsData.forEach((k, idx) => { %>
              <tr>
                <td class="ps-4 fw-bold"><%= idx + 1 %></td>
                <td class="fw-bold"><%= k.namaKelas %></td>
                <td><span class="badge rounded-pill bg-light text-dark border px-3 py-1"><%= k.kategori || 'Umum' %></span></td>
                <td><%= k.arena || 'Arena Walk-Trot' %></td>
                <td class="fw-semibold"><%= k.jumlahRun || 6 %> Run</td>
                <td><%= k.kuota || '20 Peserta' %></td>
                <td class="pe-4">
                  <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 me-1"><%= k.status || 'Aktif' %></span>
                  <span class="badge bg-warning-subtle text-dark rounded-pill px-2 py-1">IKUT POIN</span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-5">
    <div class="col-lg-6">
      <div class="sthac-card p-4 h-100">
        <h4 class="font-display fw-bold text-uppercase text-forest mb-3"><i class="bi bi-clock-history text-gold me-2"></i>Susunan Acara Hari-H (Rundown)</h4>
        <div class="table-responsive">
          <table class="table sthac-table align-middle mb-0" id="public-rundown-table">
            <thead>
              <tr>
                <th class="ps-3" style="width: 115px;">JAM</th>
                <th>KEGIATAN</th>
              </tr>
            </thead>
            <tbody>
              <% const rList = (typeof rundownList !== 'undefined' && Array.isArray(rundownList) && rundownList.length > 0) ? rundownList : [
                { jam: '07.00', kegiatan: 'Registrasi ulang peserta & pemeriksaan anak panah' },
                { jam: '07.30', kegiatan: 'Briefing panitia, juri, dan course designer' },
                { jam: '08.00', kegiatan: 'Pemanasan lintasan (walk/trot) untuk kelas Beginner' },
                { jam: '08.30', kegiatan: 'Kelas Beginner (Pemula) dimulai' },
                { jam: '10.00', kegiatan: 'Kelas Intermediate (Menengah)' },
                { jam: '12.00', kegiatan: 'Ishoma' },
                { jam: '13.00', kegiatan: 'Kelas Advanced (Mahir)' },
                { jam: '15.30', kegiatan: 'Kelas Open Qabaq (Exhibition)' },
                { jam: '16.30', kegiatan: 'Penyerahan medali & penutupan' }
              ]; %>
              <% rList.forEach((r) => { %>
                <tr>
                  <td class="ps-3 fw-bold text-gold text-nowrap"><%= r.jam %></td>
                  <td class="fw-medium"><%= r.kegiatan %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="sthac-card p-4 h-100">
        <h4 class="font-display fw-bold text-uppercase text-forest mb-3"><i class="bi bi-shield-check text-gold me-2"></i>7 Peraturan Umum Pertandingan</h4>
        <ol class="ps-3 mb-0" style="line-height: 1.8; font-size: 0.94rem;">
              <% const pList = (typeof peraturanList !== 'undefined' && peraturanList.length > 0) ? peraturanList : []; %>
              <% if (pList.length > 0) { %>
                <% pList.forEach((p) => { %>
                  <li class="mb-2"><%- p.isi %></li>
                <% }) %>
              <% } else { %>
                <li class="text-muted">Belum ada peraturan tercantum.</li>
              <% } %>
            </ol>
      </div>
    </div>
  </div>

  <div class="saiga-cta-banner p-4 p-md-5 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <h4 class="font-display fw-bold text-uppercase text-white mb-1">Ingin Berpartisipasi di Seri 1?</h4>
      <p class="small text-white-50 mb-0">Pastikan data Rider, Pelatih, dan Stable Anda sudah terdaftar sebelum kuota kelas penuh.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/pendaftaran" class="btn btn-gold-pill px-4 py-2">Daftar Sekarang</a>
      <a href="/unduhan" class="btn btn-outline-light rounded-pill px-4 py-2">Unduh THB</a>
    </div>
  </div>
</div>