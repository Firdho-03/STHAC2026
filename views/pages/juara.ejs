<div class="saiga-page-header-dark mb-2"><div class="container"><span class="sthac-eyebrow">OFFICIAL STHAC 2026</span></div></div>
<div class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2">
    <div>
      <span class="badge-gold-outline mb-2">CHAMPIONSHIP STANDINGS</span>
      <h1 class="font-display fw-bold text-uppercase text-white mb-1">Klasemen Poin Juara Umum</h1>
      <p class="text-white-50 mb-0">Dihitung otomatis dari akumulasi poin peringkat kelas pada seluruh seri yang sudah dipertandingkan.</p>
    </div>
    <button onclick="window.print()" class="btn btn-dark-pill btn-sm px-3"><i class="bi bi-printer me-1"></i> Cetak Klasemen</button>
  </div>

  <div class="sthac-card overflow-hidden mb-4">
    <div class="table-responsive">
      <table class="table table-dark sthac-table mb-0">
        <thead>
          <tr>
            <th>PERINGKAT</th>
            <th>KODE</th>
            <th>NAMA RIDER</th>
            <th>ASAL STABLE</th>
            <th class="text-center">KELAS DIIKUTI</th>
            <th class="text-center">TOTAL SKOR RUN</th>
            <th class="text-end">POIN KEJUARAAN</th>
          </tr>
        </thead>
        <tbody>
          <% if (standings.length === 0) { %>
            <tr><td colspan="7" class="text-center py-5 text-white-50">Belum ada poin yang dihitung.</td></tr>
          <% } else { %>
            <% standings.forEach(st => { %>
              <tr>
                <td class="fw-bold text-warning">Peringkat <%= st.peringkat %></td>
                <td class="font-monospace text-white-50"><%= st.kodeRider %></td>
                <td class="fw-bold text-white"><%= st.namaLengkap %></td>
                <td class="text-white-50"><%= st.asalStable %></td>
                <td class="text-center"><%= st.classesJoined %> Kelas</td>
                <td class="text-center text-white-50"><%= st.totalScoreAccum %></td>
                <td class="text-end font-display fw-bold fs-4 text-gold"><%= st.totalPoints %> pts</td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>