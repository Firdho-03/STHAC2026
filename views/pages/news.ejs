<div class="container py-5">
  <div class="mb-4">
    <span class="badge-gold-outline mb-2">BERITA &amp; PENGUMUMAN</span>          <h1 class="font-display fw-bold text-uppercase text-white mb-1">Warta STHAC 2026</h1>
    <p class="text-white-50 mb-0">Informasi resmi dari kepanitiaan South Tangerang Horseback Archery Cup.</p>
  </div>
  <div class="row g-4">
    <% newsList.forEach(n => { %>
      <div class="col-md-6">
        <div class="sthac-card p-4 h-100">
          <span class="badge bg-warning text-dark fw-bold mb-2"><%= n.kategori %></span>
          <!-- PUBLIC WARTA PHOTO START -->
          <% const _cardPhoto = n.fotoUrl || n.foto || n.gambar || n.image || ''; %>
          <% if (_cardPhoto && String(_cardPhoto).trim().length > 4) { %>
            <div class="mb-3 rounded-3 overflow-hidden border sthac-news-photo-box" style="height: 215px; background: rgba(7,38,25,0.06);">
              <img src="<%= _cardPhoto %>" alt="<%= n.judul %>" class="w-100 h-100 object-fit-cover d-block sthac-public-news-img" />
            </div>
          <% } %>
          <!-- PUBLIC WARTA PHOTO END -->
          <h4 class="font-display fw-bold text-white mb-2"><%= n.judul %></h4>
          <p class="text-gold-bright small mb-2"><%= n.ringkasan %></p>
          <p class="text-white-50 small mb-0"><%= n.isiBerita %></p>
        </div>
      </div>
    <% }) %>
  </div>
</div>