<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" href="<%= setting.logoUrl %>" />
  <script>
    // Terapkan tema tersimpan sebelum render agar tidak berkedip (Zero FOUC)
    (function() {
      const savedTheme = localStorage.getItem('sthac_theme_mode') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
  <link href="/css/sthac-luxury.css" rel="stylesheet">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="d-flex flex-column min-vh-100">
  <div id="sthac-scroll-progress"></div>

  <!-- NAVBAR DENGAN SAKELAR DUAL MODE (LIGHT / DARK) -->
  <nav class="navbar navbar-expand-xl navbar-sthac sticky-top py-2">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-3 py-1" href="/">
        <img src="<%= setting.logoUrl %>" alt="STHAC Logo" class="brand-emblem" onerror="this.style.display='none'" />
        <div>
          <span class="font-display fw-bold d-block text-uppercase lh-1 brand-title" style="font-size:1.02rem;letter-spacing:0.8px;">
            <%= setting.eventName %>
          </span>
          <small class="d-block mt-1 brand-subtitle" style="font-size:0.7rem;letter-spacing:0.4px;">
            Seri Kejuaraan 2026 · Tangerang Selatan
          </small>
        </div>
      </a>

      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#sthacMainNav">
        <i class="bi bi-list fs-2 brand-title"></i>
      </button>

      <div class="collapse navbar-collapse" id="sthacMainNav">
        <ul class="navbar-nav ms-auto mb-2 mb-xl-0 align-items-xl-center gap-1 mt-3 mt-xl-0">
          <li class="nav-item">
            <a class="nav-link <%= activePage === 'beranda' ? 'active' : '' %>" href="/">
              <i class="bi bi-house-door me-1"></i> Beranda
            </a>
          </li>

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= ['event','seri','aturan','unduhan'].includes(activePage) ? 'active' : '' %>" href="#" role="button" data-bs-toggle="dropdown">
              <i class="bi bi-trophy me-1"></i> Kejuaraan
            </a>
            <ul class="dropdown-menu dropdown-menu-sthac">
              <li><a class="dropdown-item" href="/event"><i class="bi bi-calendar-event me-2 text-warning"></i> Event &amp; Jadwal Seri 1</a></li>
              <li><a class="dropdown-item" href="/seri"><i class="bi bi-map me-2 text-warning"></i> Roadmap Seri 1–3</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/aturan"><i class="bi bi-journal-check me-2 text-warning"></i> Regulasi &amp; Aturan Penilaian</a></li>
              <li><a class="dropdown-item" href="/unduhan"><i class="bi bi-download me-2 text-warning"></i> Pusat Unduhan Dokumen</a></li>
            </ul>
          </li>

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= ['skor','juara'].includes(activePage) ? 'active' : '' %>" href="#" role="button" data-bs-toggle="dropdown">
              <i class="bi bi-broadcast me-1"></i> Live &amp; Skor
            </a>
            <ul class="dropdown-menu dropdown-menu-sthac">
              <li><a class="dropdown-item" href="/skor"><i class="bi bi-stopwatch me-2 text-danger"></i> Papan Skor Live</a></li>
              <li><a class="dropdown-item" href="/juara"><i class="bi bi-award me-2 text-warning"></i> Klasemen Poin Juara Umum</a></li>
            </ul>
          </li>

          <li class="nav-item">
            <a class="nav-link <%= activePage === 'profile' ? 'active' : '' %>" href="/profile">
              <i class="bi bi-people me-1"></i> Profil Ekosistem
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link <%= activePage === 'news' ? 'active' : '' %>" href="/news">
              <i class="bi bi-newspaper me-1"></i> Berita
            </a>
          </li>

          <!-- Tombol Switcher Light / Dark Mode -->
          <li class="nav-item ms-xl-2">
            <button type="button" onclick="toggleThemeMode()" class="btn-theme-toggle" id="btn-theme-switch" title="Ubah Mode Tampilan (Terang / Gelap)">
              <i class="bi bi-moon-stars-fill text-warning" id="icon-theme-mode"></i>
              <span id="label-theme-mode">Dark</span>
            </button>
          </li>

          <li class="nav-item ms-xl-1">
            <a href="/pendaftaran" class="btn btn-gold-pill px-4 py-2">
              <i class="bi bi-person-plus-fill me-1"></i> Daftar
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- VIEWPORT UTAMA -->
  <main class="flex-grow-1">
    <%- body %>
  </main>

  <!-- FOOTER MULTI-KOLOM ADAPTIF -->
  <footer class="sthac-footer mt-auto pt-5 pb-4">
    <div class="container">
      <div class="row g-4 pb-4 border-bottom" style="border-color:var(--border-main) !important;">
        <div class="col-lg-5 d-flex align-items-start gap-3">
          <img src="<%= setting.logoUrl %>" alt="STHAC Emblem" style="width:56px;height:56px;object-fit:contain;" onerror="this.style.display='none'" />
          <div>
            <h5 class="font-display fw-bold text-uppercase text-forest mb-1"><%= setting.eventName %></h5>
            <p class="small mb-2"><%= setting.tagline %> · <%= setting.footerOrg %></p>
            <div class="small">
              <i class="bi bi-geo-alt-fill text-warning me-1"></i> <%= setting.location %>
            </div>
          </div>
        </div>
        <div class="col-6 col-lg-3 small">
          <h6 class="font-display fw-bold text-uppercase text-forest mb-2">Navigasi Cepat</h6>
          <div class="vstack gap-1">
            <a href="/event" class="text-decoration-none text-secondary">Event &amp; Jadwal Seri 1</a>
            <a href="/skor" class="text-decoration-none text-secondary">Papan Skor Pertandingan</a>
            <a href="/juara" class="text-decoration-none text-secondary">Klasemen Poin Juara Umum</a>
            <a href="/aturan" class="text-decoration-none text-secondary">Regulasi IHAA &amp; Pordasi</a>
          </div>
        </div>
        <div class="col-6 col-lg-4 text-lg-end small">
          <h6 class="font-display fw-bold text-uppercase text-forest mb-2">Kontak &amp; Kepanitiaan</h6>
          <div class="mb-1"><i class="bi bi-calendar-event text-warning me-1"></i> Seri 1: Sabtu, 14 November 2026</div>
          <div class="mb-2">
            <i class="bi bi-whatsapp text-success me-1"></i> <%= setting.whatsapp %> &nbsp;·&nbsp;
            <i class="bi bi-instagram text-warning me-1"></i> <%= setting.instagram %>
          </div>
          <a href="/panitia" class="btn btn-forest-pill btn-sm px-3 py-1">
            <i class="bi bi-shield-lock-fill me-1 text-warning"></i> Masuk Panitia
          </a>
        </div>
      </div>
      <div class="pt-3 d-flex flex-wrap justify-content-between align-items-center small">
        <div>&copy; 2026 <%= setting.eventName %> · <%= setting.footerOrg %></div>
        <div>Penilaian mengacu pada sistem <strong class="text-forest">IHAA</strong> &amp; format nasional <strong class="text-forest">Pordasi Berkuda Memanah</strong>.</div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function syncThemeButtonUI() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const iconEl = document.getElementById('icon-theme-mode');
      const labelEl = document.getElementById('label-theme-mode');
      if (!iconEl || !labelEl) return;

      if (current === 'dark') {
        iconEl.className = 'bi bi-sun-fill text-warning';
        labelEl.innerText = 'Light';
      } else {
        iconEl.className = 'bi bi-moon-stars-fill text-forest';
        labelEl.innerText = 'Dark';
      }
    }

    function toggleThemeMode() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('sthac_theme_mode', next);
      syncThemeButtonUI();
    }

    document.addEventListener('DOMContentLoaded', syncThemeButtonUI);

    const socket = io();
    socket.on('score_updated', () => {
      if (['/skor', '/juara', '/'].includes(window.location.pathname)) {
        window.location.reload();
      }
    });
  </script>
  <!-- STHAC_HIGH_IMPACT_MOTION_ENGINE -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const progressBar = document.getElementById('sthac-scroll-progress');
      const mainNavbar = document.querySelector('.navbar-sthac');
      const heroSection = document.querySelector('.sthac-hero-glass');
      const heroEmblem = document.querySelector('.hero-emblem-showcase');
      const isPanitiaPage = window.location.pathname.includes('/panitia') || window.location.pathname.includes('/admin');

      // 1. PARALLAX & SCROLL PROGRESS BAR
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        if (progressBar && docHeight > 0) {
          progressBar.style.width = ((scrollTop / docHeight) * 100).toFixed(2) + '%';
        }
        if (mainNavbar) {
          if (scrollTop > 20) mainNavbar.classList.add('navbar-scrolled');
          else mainNavbar.classList.remove('navbar-scrolled');
        }
        if (heroSection && scrollTop < 850) {
          const yOffset = (scrollTop * 0.28).toFixed(1);
          heroSection.style.backgroundPosition = '58% calc(38% + ' + yOffset + 'px)';
        }
      }, { passive: true });

      // 2. INTERACTIVE 3D HERO TILT PADA MOUSE MOVE
      if (heroSection && heroEmblem) {
        heroSection.addEventListener('mousemove', (e) => {
          const rect = heroSection.getBoundingClientRect();
          const xRatio = (e.clientX - rect.left) / rect.width - 0.5;
          const yRatio = (e.clientY - rect.top) / rect.height - 0.5;
          const moveX = (xRatio * 28).toFixed(1);
          const moveY = (yRatio * 22).toFixed(1);
          const rotY = (xRatio * 18).toFixed(1);
          const rotX = (-yRatio * 18).toFixed(1);
          heroEmblem.style.transform = 'perspective(900px) translate3d(' + moveX + 'px, ' + moveY + 'px, 0) rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg)';
        });
        heroSection.addEventListener('mouseleave', () => {
          heroEmblem.style.transition = 'transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)';
          heroEmblem.style.transform = 'perspective(900px) translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg)';
          setTimeout(() => { heroEmblem.style.transition = ''; }, 600);
        });
      }

      if (isPanitiaPage) return;

      // 3. PASANG DIRECTIONAL SCROLL-REVEAL (KIRI, KANAN, BAWAH, ZOOM)
      const allCardsAndBlocks = [];

      // Header setiap section meluncur dari kiri
      document.querySelectorAll('main section h2, main .container h1').forEach((h) => {
        h.classList.add('reveal-on-scroll', 'reveal-header');
        allCardsAndBlocks.push(h);
      });

      // Kartu 2 Kolom (misal Sistem Penilaian IHAA vs Pordasi): Kiri masuk dari kiri, Kanan masuk dari kanan
      document.querySelectorAll('main .row').forEach((row) => {
        const cols2 = row.querySelectorAll(':scope > .col-lg-6 > .sthac-card');
        if (cols2.length === 2) {
          cols2[0].classList.add('reveal-on-scroll', 'reveal-from-left');
          cols2[0].style.setProperty('--reveal-delay', '60ms');
          cols2[1].classList.add('reveal-on-scroll', 'reveal-from-right');
          cols2[1].style.setProperty('--reveal-delay', '200ms');
          allCardsAndBlocks.push(cols2[0], cols2[1]);
        }

        // Kartu 3 Kolom (Poin Kejuaraan & Unduhan Dokumen): Staggered Cascade Bounce
        const cols3 = row.querySelectorAll(':scope > .col-md-4 > .sthac-card, :scope > .col-lg-4 > .sthac-card');
        cols3.forEach((card, idx) => {
          card.classList.add('reveal-on-scroll');
          card.style.setProperty('--reveal-delay', ((idx % 3) * 150) + 'ms');
          allCardsAndBlocks.push(card);
        });
      });

      // Kartu tunggal & Banner CTA
      document.querySelectorAll('main .sthac-card, main .saiga-cta-banner, main .saiga-photo-banner').forEach((el) => {
        if (!el.classList.contains('reveal-on-scroll')) {
          el.classList.add('reveal-on-scroll', 'reveal-zoom-banner');
          allCardsAndBlocks.push(el);
        }
      });

      // Observer Dua Arah: Saat masuk viewport langsung animasi masuk, saat keluar di bawah viewport siap animasi lagi ketika di-scroll ulang
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          } else {
            const rect = entry.target.getBoundingClientRect();
            if (rect.top > window.innerHeight * 0.85) {
              entry.target.classList.remove('is-visible');
            }
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });

      allCardsAndBlocks.forEach((el) => revealObserver.observe(el));

      // 4. 3D MAGNETIC CARD TILT & GOLDEN SPOTLIGHT SAAT HOVER KARTU
      document.querySelectorAll('main .sthac-card').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          if (!card.classList.contains('is-visible')) return;
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', x + 'px');
          card.style.setProperty('--mouse-y', y + 'px');

          const xPct = x / rect.width - 0.5;
          const yPct = y / rect.height - 0.5;
          const tiltX = (-yPct * 7).toFixed(2);
          const tiltY = (xPct * 7).toFixed(2);
          card.style.transition = 'transform 0.08s ease-out, box-shadow 0.3s ease, border-color 0.3s ease';
          card.style.transform = 'perspective(1000px) translate3d(0, -8px, 0) rotateX(' + tiltX + 'deg) rotateY(' + tiltY + 'deg) scale(1.015)';
        });

        card.addEventListener('mouseleave', () => {
          card.style.transition = 'transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, border-color 0.35s ease';
          card.style.transform = 'perspective(1000px) translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg) scale(1)';
        });
      });

      // 5. ANIMATED NUMBER COUNTER UNTUK ANGKA POIN SAAT DI-SCROLL
      document.querySelectorAll('main .sthac-card .fs-4, main .sthac-card .fs-3').forEach((numEl) => {
        const rawText = numEl.innerText.trim();
        const match = rawText.match(/^(\d+(?:\.\d+)?)(\s*pts)?$/i);
        if (!match) return;
        const targetVal = parseFloat(match[1]);
        const suffix = match[2] || '';
        if (isNaN(targetVal) || targetVal <= 0) return;

        const counterObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              let start = 0;
              const duration = 900;
              const startTime = performance.now();
              function step(now) {
                const progress = Math.min(1, (now - startTime) / duration);
                const eased = 1 - Math.pow(1 - progress, 3);
                const cur = Math.round(targetVal * eased);
                numEl.innerText = cur + suffix;
                if (progress < 1) requestAnimationFrame(step);
                else numEl.innerText = targetVal + suffix;
              }
              requestAnimationFrame(step);
            }
          });
        }, { threshold: 0.5 });

        counterObserver.observe(numEl);
      });
    });
  </script>

</body>
</html>