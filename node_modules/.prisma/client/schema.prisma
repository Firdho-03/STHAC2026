generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./sthac.db"
}

model SiteSetting {
  id                  Int     @id @default(1)
  eventName           String  @default("South Tangerang Horseback Archery Cup")
  shortCode           String  @default("STHAC 2026")
  tagline             String  @default("Kejuaraan Berkuda Memanah Berjenjang")
  headline            String  @default("Seri 1 · 14 November 2026 · SAIGA STABLE")
  eventDate           String  @default("2026-11-14")
  location            String  @default("Saiga Stable, Tangerang Selatan, Banten")
  mapUrl              String  @default("https://maps.app.goo.gl/GYhRn6S6f7zPq4iy8")
  whatsapp            String  @default("081586844344")
  contactName         String  @default("Admin STHAC")
  email               String  @default("hbatangsel.official@gmail.com")
  instagram           String  @default("@sthac2026")
  footerOrg           String  @default("Diselenggarakan Oleh: Saiga Stable")
  logoUrl             String  @default("https://media.vibecoder.co.id/app-media/ilham/south-tangerang-hacup/230836bd-5988-4bad-8ea9-c1eda8d6d2c4.png")
  bgColor             String  @default("#03130C")
  goldColor           String  @default("#D9B45C")
  brightGoldColor     String  @default("#F2E0AC")
  adminDisplayName    String  @default("Panitia STHAC")
  adminPassword       String  @default("sthac2026")
  registrationOpen    Boolean @default(true)
  kategoriList        String  @default("U14,Terbuka,Senior Putra,Senior Putri")
  pointsMapJson       String  @default("{\"1\":20,\"2\":15,\"3\":12,\"4\":10,\"5\":8,\"6\":6,\"7\":4,\"8\":3,\"9\":2,\"10\":1}")
  poinLuarDaftar      Int     @default(1)
  hitungNKelasTerbaik Int     @default(0)
}

model Stable {
  id             Int      @id @default(autoincrement())
  namaStable     String
  kotaKabupaten  String
  provinsi       String   @default("Banten")
  alamat         String   @default("-")
  noWa           String   @default("-")
  email          String   @default("-")
  pelatihUtama   String   @default("-")
  status         String   @default("Aktif")
  logoUrl        String?
  deskripsi      String   @default("-")
  statusAcc      String   @default("Diterima")
  catatanPanitia String?
  createdAt      DateTime @default(now())
}

model Pelatih {
  id                Int      @id @default(autoincrement())
  kodePelatih       String   @default("P-001")
  namaLengkap       String
  namaPanggilan     String   @default("-")
  spesialis         String   @default("Berkuda Memanah")
  sertifikasi       String   @default("-")
  pengalamanMelatih String   @default("-")
  noWa              String   @default("-")
  email             String   @default("-")
  stableAsal        String   @default("-")
  kota              String   @default("Tangerang Selatan")
  status            String   @default("Aktif")
  fotoUrl           String?
  bio               String   @default("-")
  statusAcc         String   @default("Diterima")
  catatanPanitia    String?
  createdAt         DateTime @default(now())
}

model Rider {
  id              Int        @id @default(autoincrement())
  kodeRider       String     @default("R-001")
  noBib           Int        @default(1)
  namaLengkap     String
  namaPanggilan   String     @default("-")
  kategori        String     @default("Terbuka")
  jenjangKelas    String     @default("Beginner (Pemula)")
  kelasDiikuti    String     @default("Beginner (Walk)")
  tanggalLahir    String     @default("2010-01-01")
  asalStable      String     @default("SAIGA STABLE")
  pelatihNama     String     @default("-")
  kotaKabupaten   String     @default("Tangerang Selatan")
  noWa            String     @default("-")
  email           String     @default("-")
  pengalaman      String     @default("-")
  fotoUrl         String?
  catatanTambahan String?
  statusAcc       String     @default("Pending") // Pending, Diterima, Ditolak
  catatanPanitia  String?
  alasanPenolakan String?
  scores          ScoreRun[]
  createdAt       DateTime   @default(now())
}

model Lintasan {
  id                 Int                 @id @default(autoincrement())
  kodeLintasan       String              @unique
  namaLintasan       String
  sistem             String              @default("IHAA") // IHAA atau Pordasi Berkuda Memanah
  gambarUrl          String?
  panjangMeter       Float               @default(90)
  jumlahTarget       Int                 @default(3)
  nilaiZonaTarget    String              @default("5,4,3,2,1")
  parTime            Float               @default(14.0)
  batasWaktu         Float               @default(0)
  bonusWaktuPerDetik Float               @default(1.0)
  penaltiWaktuPerDtk Float               @default(1.0)
  bonusWaktuMaks     Float               @default(0)
  minTargetKenaBonus Int                 @default(1)
  pengaliBonusWaktu  String              @default("") // contoh: 1:0.5, 2:1, 3:1.5
  bonusSapuBersih    Float               @default(0)
  syaratBonusSapu    String              @default("Semua target kena")
  aturanOvertime     String              @default("Poin target tetap dihitung")
  namaBonusSatuan    String              @default("")
  poinBonusSatuan    Float               @default(0)
  dendaBonusSatuan   Float               @default(0)
  urutanTampil       Int                 @default(1)
  kelasList          KelasPertandingan[]
}

model SeriEvent {
  id             Int                 @id @default(autoincrement())
  nomorSeri      Int                 @default(1)
  namaSeri       String
  tanggalMulai   String              @default("2026-11-14")
  tanggalSelesai String              @default("2026-11-14")
  tanggalTampil  String              @default("14 Nov 2026")
  tempat         String              @default("Saiga Stable")
  kota           String              @default("Tangerang Selatan, Banten")
  status         String              @default("Pendaftaran dibuka")
  deskripsi      String              @default("-")
  susunanAcara   String              @default("-")
  kelasList      KelasPertandingan[]
  scores         ScoreRun[]
}

model KelasPertandingan {
  id                  Int        @id @default(autoincrement())
  seriId              Int
  seri                SeriEvent  @relation(fields: [seriId], references: [id], onDelete: Cascade)
  lintasanId          Int?
  lintasanRel         Lintasan?  @relation(fields: [lintasanId], references: [id])
  namaKelas           String
  labelJenjangInggris String     @default("Beginner")
  kategori            String     @default("U14")
  namaLintasan        String     @default("Arena Walk-Trot")
  jumlahRun           Int        @default(6)
  biayaPendaftaran    Int        @default(0)
  kuotaPeserta        Int        @default(20)
  pesertaTerisi       Int        @default(0)
  urutanTampil        Int        @default(1)
  juriUtamaKelas      String     @default("Belum ditentukan")
  pencatatSkorKelas   String     @default("Belum ditentukan")
  buangSkorTerendah   Boolean    @default(false)
  hitungPoinJuara     Boolean    @default(true)
  statusKelas         String     @default("AKTIF")
  scores              ScoreRun[]
}

model PanitiaJuri {
  id           Int       @id @default(autoincrement())
  namaLengkap  String
  panggilan    String
  peran        String    @default("Panitia") // Juri Utama, Juri, Scorer/Pencatat, Timer, Course Designer, Starter, Tim Medis
  urutanTampil Int       @default(1)
  sertif       String    @default("-")
  kontakWa     String    @default("-")
  email        String    @unique
  kodeAkses    String    @default("sthac2026")
  otpCode      String?
  otpExpiry    DateTime?
  status       String    @default("Aktif")
  fotoUrl      String?
  bioTugas     String    @default("-")
  createdAt    DateTime  @default(now())
}

model ScoreRun {
  id          Int                @id @default(autoincrement())
  riderId     Int
  rider       Rider              @relation(fields: [riderId], references: [id], onDelete: Cascade)
  seriId      Int
  seri        SeriEvent          @relation(fields: [seriId], references: [id], onDelete: Cascade)
  kelasId     Int?
  kelasRel    KelasPertandingan? @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  kelas       String
  noBib       Int                @default(1)
  runNumber   Int
  target1     Float              @default(0)
  target2     Float              @default(0)
  target3     Float              @default(0)
  target4     Float              @default(0)
  target5     Float              @default(0)
  waktuTempuh Float              @default(0)
  batasWaktu  Float              @default(14.0)
  poinTarget  Float              @default(0)
  bonusWaktu  Float              @default(0)
  bonusLain   Float              @default(0)
  totalSkor   Float              @default(0)
  updatedAt   DateTime           @updatedAt
}

model Dokumen {
  id         Int      @id @default(autoincrement())
  judul      String
  kodeBadge  String   @default("THB")
  kategori   String   @default("Modul Seri")
  statusInfo String   @default("Menyusul")
  ukuran     String   @default("-")
  fileUrl    String   @default("#")
  uploadedAt DateTime @default(now())
}

model News {
  id          Int      @id @default(autoincrement())
  judul       String
  kategori    String   @default("Pengumuman")
  ringkasan   String   @default("-")
  isiBerita   String
  gambarUrl   String?
  publishedAt DateTime @default(now())
}
